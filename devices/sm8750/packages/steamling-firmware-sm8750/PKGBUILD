# Vendor firmware for the SM8750 boards that upstream linux-firmware lacks: the ROCKNIX/extra-firmware
# SM8750/ tree. Pinned by commit + sha256, nothing
# in git; installed under /usr/lib/firmware/updates/, which wins the kernel's search.
pkgname=steamling-firmware-sm8750
pkgver=0.1.1
pkgrel=1
pkgdesc="SM8750 handheld vendor firmware (wifi, bluetooth, ADSP/CDSP, GPU zap, audio, VPU)"
arch=('any')
url="https://github.com/dvandenburgh/steamling"
license=('custom:qcom-firmware')   # Qualcomm vendor blobs
# firmware blobs must ship byte-identical; some parse as ELF and strip would alter them
options=('!strip')

_extrafw=8834a0c80f5b24fee5ed9e18c1560dc48a6f1bd9   # ROCKNIX/extra-firmware, SM8750/
_extrafw_files=(
