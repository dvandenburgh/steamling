source=()
for _f in "${_extrafw_files[@]}"; do
  source+=("${_f//\//_}::https://raw.githubusercontent.com/ROCKNIX/extra-firmware/${_extrafw}/SM8550/${_f}")
done
for _f in "${_armada_files[@]}"; do
  source+=("${_f//\//_}::https://raw.githubusercontent.com/armada-os/armada/${_armada}/system_files/usr/lib/firmware/${_f}")
done
# Sensor core (gyro) data per board, captured by armada from each board's stock Android. The ADSP
# reads it through hexagonrpcd (steamling-ssc), and it only works with the exact ADSP firmware it
# was captured on, so package() checks its recorded hashes against the firmware above.
# <board> <armada capture name>
_ssc=b031deef99a095104ef234c5a0705850152dffe1   # armada-os/armada, packages/armada-ssc/data/
_ssc_boards=(
  'rp6 retroid-pocket-6'
)
for _b in "${_ssc_boards[@]}"; do
  source+=("ssc-${_b%% *}.tar.gz::https://raw.githubusercontent.com/armada-os/armada/${_ssc}/packages/armada-ssc/data/${_b#* }.tar.gz")
  noextract+=("ssc-${_b%% *}.tar.gz")
done
