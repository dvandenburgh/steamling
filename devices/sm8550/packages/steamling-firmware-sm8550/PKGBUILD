# Vendor firmware for the SM8550 boards that upstream linux-firmware lacks or gets wrong (ath12k
# WCN7850, ADSP/CDSP per board, speaker amp tuning, audio topologies, VPU). Pinned by commit +
# sha256, nothing in git. The ROCKNIX/extra-firmware SM8550/ tree carries every board's set; the RP6
# runs its own ADSP build (extracted from a Retroid Android image) from
# qcom/sm8550/retroidpocket/rp6/. /usr/lib/firmware/updates/ wins the kernel's search and no ALARM
# package writes there, so linux-firmware updates never revert the ath12k board file wifi needs.
pkgname=steamling-firmware-sm8550
pkgver=0.1.1
pkgrel=2
pkgdesc="SM8550 handheld vendor firmware (wifi, ADSP/CDSP, audio, VPU, sensor data), immune to linux-firmware updates"
arch=('any')
url="https://github.com/dvandenburgh/steamling"
license=('custom:qcom-firmware')   # Qualcomm vendor blobs
# firmware blobs must ship byte-identical; some parse as ELF and strip would alter them
options=('!strip')

