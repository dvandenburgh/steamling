package() {
  local _f
  for _f in "${_extrafw_files[@]}" "${_armada_files[@]}"; do
    install -Dm644 "${srcdir}/${_f//\//_}" "${pkgdir}/usr/lib/firmware/updates/${_f}"
  done
  # A symlink in extra-firmware (raw downloads would fetch the link text): the Thor's card loads
  # the Odin 2 topology under its own name.
  ln -s AYN-Odin2-tplg.bin "${pkgdir}/usr/lib/firmware/updates/qcom/sm8550/AYN-Thor-tplg.bin"
  # The RP6 and Nova card (SM8550-RetroidPocket-I2S, Retroid's name for it) uses the same graph:
  # speakers on Primary MI2S, headphones on RX codec DMA 0, mics on TX codec DMA 3, DP.
  ln -s AYN-Odin2-tplg.bin "${pkgdir}/usr/lib/firmware/updates/qcom/sm8550/SM8550-RetroidPocket-I2S-tplg.bin"

  local _b _board _dest _e _fw
  for _b in "${_ssc_boards[@]}"; do
    _board="${_b%% *}"
    _dest="${pkgdir}/usr/share/steamling/ssc/${_board}"
    mkdir -p "${_dest}"
    tar -xzf "${srcdir}/ssc-${_board}.tar.gz" -C "${_dest}" --no-same-owner
    for _e in $(sed -n 's/^adsp_sha256=//p' "${_dest}/SOURCE"); do
      _fw="${pkgdir}/usr/lib/firmware/updates/${_e%%:*}"
      [ "$(sha256sum "${_fw}" 2>/dev/null | cut -d' ' -f1)" = "${_e#*:}" ] || {
        echo "${_board}: sensor data was captured on a different ${_e%%:*}" >&2
        return 1
      }
    done
    # The registry records every config's mtime as 0; any other mtime makes the ADSP reparse
    # them all at boot.
    find "${_dest}" -newermt @0 -exec touch -h -d @0 {} +
  done
}
