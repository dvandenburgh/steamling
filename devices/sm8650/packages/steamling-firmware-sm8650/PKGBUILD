# Vendor firmware for the SM8650 boards that upstream linux-firmware lacks: the ROCKNIX/extra-firmware
# SM8650/ tree. Pinned by commit + sha256, nothing
# in git; installed under /usr/lib/firmware/updates/, which wins the kernel's search.
pkgname=steamling-firmware-sm8650
pkgver=0.1.1
pkgrel=1
pkgdesc="SM8650 handheld vendor firmware (wifi, ADSP/CDSP, GPU zap, audio)"
arch=('any')
url="https://github.com/dvandenburgh/steamling"
license=('custom:qcom-firmware')   # Qualcomm vendor blobs
# firmware blobs must ship byte-identical; some parse as ELF and strip would alter them
options=('!strip')

_extrafw=8834a0c80f5b24fee5ed9e18c1560dc48a6f1bd9   # ROCKNIX/extra-firmware, SM8650/
_extrafw_files=(
  ath12k/WCN7850/hw2.0/Notice.txt
  ath12k/WCN7850/hw2.0/amss.bin
  ath12k/WCN7850/hw2.0/board-2.bin
  ath12k/WCN7850/hw2.0/m3.bin
  qcom/gen70900_aqe.fw
  qcom/gen70900_sqe.fw
  qcom/gmu_gen70900.bin
  qcom/sm8650/SM8650-APS2-tplg.bin
  qcom/sm8650/ayaneo/ps2/adsp.mbn
  qcom/sm8650/ayaneo/ps2/adsp_dtb.mbn
  qcom/sm8650/ayaneo/ps2/adspr.jsn
  qcom/sm8650/ayaneo/ps2/adsps.jsn
  qcom/sm8650/ayaneo/ps2/adspua.jsn
  qcom/sm8650/ayaneo/ps2/battmgr.jsn
  qcom/sm8650/ayaneo/ps2/cdsp.mbn
  qcom/sm8650/ayaneo/ps2/cdsp_dtb.mbn
  qcom/sm8650/ayaneo/ps2/cdspr.jsn
  qcom/sm8650/ayaneo/ps2/focalfp.mbn
  qcom/sm8650/ayaneo/ps2/gen70900_zap.mbn
  qcom/sm8650/ayaneo/ps2/ipa_fws.mbn
  renesas_usb_fw.mem
)
_armada_files=()
source=()
for _f in "${_extrafw_files[@]}"; do
  source+=("${_f//\//_}::https://raw.githubusercontent.com/ROCKNIX/extra-firmware/${_extrafw}/SM8650/${_f}")
done
