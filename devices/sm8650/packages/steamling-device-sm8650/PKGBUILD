         'steamling-bootloader-sm8650'
         'proton-cachyos'
         'proton-ge')
# Exactly one device metapackage per install (wrong-device guard).
provides=('steamling-device')
conflicts=('steamling-device')

package() {
  :   # pure metapackage
}
