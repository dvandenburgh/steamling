# Board support for the SM8250 family: device.conf picks a boards/ file by devicetree model
# and the input maps are model-gated, so one package serves every board.
pkgname=steamling-bsp-sm8250
pkgver=0.1.1
pkgrel=1.1
pkgdesc="steamling board support: SM8250 family (Retroid Pocket 5, Retroid Pocket Flip2, Retroid Pocket Mini, Retroid Pocket Mini V2, AYN Thor Lite, MANGMI Air Y Pro, MANGMI Pocket Max, AYANEO Pocket MICRO 2) - board dispatch, input maps, audio UCM"
arch=('any')
url="https://github.com/dvandenburgh/steamling"
license=('GPL-2.0-or-later')
# The firmware reaches the fleet through this edge: -Syu never installs a new name alone.
depends=('steamling-bsp-common>=0.1.0-26.17' 'steamling-firmware-sm8250')
# One BSP per device (wrong-device guard).
provides=('steamling-bsp')
conflicts=('steamling-bsp')
optdepends=('inputplumber: gamepad -> Steam Input mapping'
            'alsa-ucm-conf: base UCM (codec include sequences)')

package() {
  # scripts/render-bsp.sh renders device.conf and family.conf into ./staged (build-packages.sh).
  install -Dm644 "${startdir}/staged/device.conf" "${pkgdir}/usr/lib/steamling/device.conf"
  # root/ is the install tree; -d keeps the UCM symlinks as links.
  cp -dr "${startdir}/root/." "${pkgdir}/"
  # The on-device boot image rebuild bakes this in; build-packages.sh stages it from the profile.
  install -Dm644 "${startdir}/staged/kernel-cmdline" "${pkgdir}/usr/lib/steamling/kernel-cmdline"
  local b
  for b in "${startdir}/boards/"*.conf "${startdir}/staged/family.conf"; do
    install -Dm644 "${b}" "${pkgdir}/usr/lib/steamling/boards/$(basename "${b}")"
  done
}
