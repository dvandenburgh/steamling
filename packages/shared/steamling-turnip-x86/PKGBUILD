# steamling-turnip-x86 — the host-side catalog of the archived x86_64 Turnip builds the "Mesa
# Version" tweak points VK_DRIVER_FILES at: one icd.json per version, which steamling-game-launch
# and the Decky dropdown list. The drivers themselves live in fex-rootfs's image; FEX resolves
# x86 paths there first, so a host copy of them was never loaded. _versions must therefore match
# fex-rootfs's _vkvers: a version listed here and missing there would be offered with no driver.
# Series start at 25.2: older ones predate Arch's per-driver x86_64 split.
pkgname=steamling-turnip-x86
pkgver=20261123
pkgrel=1
pkgdesc="Catalog of the x86_64 Turnip builds for per-game Mesa selection under FEX"
arch=('aarch64')
url="https://github.com/Steamling/steamling"
license=("MIT AND BSD-3-Clause AND SGI-B-2.0")   # Mesa's Turnip builds, repackaged
depends=('fex-rootfs')
_versions=('25.2.7-1' '25.3.5-1' '26.0.6-1' '26.1.6-1' '26.2.4-1' '26.3.1-3')
source=("vulkan-freedreno-25.2.7-1-x86_64.pkg.tar.zst::https://archive.archlinux.org/packages/v/vulkan-freedreno/vulkan-freedreno-1%3A25.2.7-1-x86_64.pkg.tar.zst"
        "vulkan-freedreno-25.3.5-1-x86_64.pkg.tar.zst::https://archive.archlinux.org/packages/v/vulkan-freedreno/vulkan-freedreno-1%3A25.3.5-1-x86_64.pkg.tar.zst"
        "vulkan-freedreno-26.0.6-1-x86_64.pkg.tar.zst::https://archive.archlinux.org/packages/v/vulkan-freedreno/vulkan-freedreno-1%3A26.0.6-1-x86_64.pkg.tar.zst"
        "vulkan-freedreno-26.1.6-1-x86_64.pkg.tar.zst::https://archive.archlinux.org/packages/v/vulkan-freedreno/vulkan-freedreno-1%3A26.1.6-1-x86_64.pkg.tar.zst"
        "vulkan-freedreno-26.2.4-1-x86_64.pkg.tar.zst::https://archive.archlinux.org/packages/v/vulkan-freedreno/vulkan-freedreno-1%3A26.2.4-1-x86_64.pkg.tar.zst"
        "vulkan-freedreno-26.3.1-3-x86_64.pkg.tar.zst::https://archive.archlinux.org/packages/v/vulkan-freedreno/vulkan-freedreno-1%3A26.3.1-3-x86_64.pkg.tar.zst")
noextract=("${source[@]%%::*}")
sha256sums=('b5554bb73674d6a5e7772bee71abd0e9d40929c61b5b690f79aba041ccffb5a8'
            '6eecca2a8b639458371eca29e93605f83d7dc5ee7a3dab5980beddb758e90331'
            '3d0c11b665b3409c8b6372f0369192355743d821727248115f973bd2c15bbbde'
            '6b5785d7b7d7993a828d3f79c6c0e369a619d6e786dd2cfdfd8ac4ab1ad8a2d2'
            'da30385afabfee1fba0456ff03e1a4f9d8168dc12679323f90bd496e5259e435'
            '28e302fabb45242d0187ccf21b5a9751c3a797d21ea432b42cda4b59dd298f36')

package() {
  local full ver dir
  for full in "${_versions[@]}"; do
    ver="${full%-*}"                                # 25.2.7-1 -> 25.2.7 (dir + tweak value)
    dir="${pkgdir}/usr/share/steamling/vk-x86/${ver}"
    install -d -m755 "${dir}"
    # Reuse the package's own ICD json for its api_version, but rewrite library_path
    # unconditionally: 26.x switched it to a bare soname, which resolves to the rootfs copy.
    tar --zstd -xOf "${srcdir}/vulkan-freedreno-${full}-x86_64.pkg.tar.zst" \
      --wildcards 'usr/share/vulkan/icd.d/freedreno_icd*.json' \
      | sed -E "s|\"library_path\": *\"[^\"]*\"|\"library_path\": \"/usr/share/steamling/vk-x86/${ver}/libvulkan_freedreno.so\"|" \
      > "${dir}/icd.json"
    chmod 0644 "${dir}/icd.json"
  done
}
