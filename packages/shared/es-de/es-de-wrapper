#!/bin/bash
# SDL2 discards joystick events while no SDL window has keyboard focus, and the ES-DE window
# comes back from suspend without it; ES-DE sets no hint of its own. gamescope never drops focus.
if [ -z "${GAMESCOPE_WAYLAND_DISPLAY:-}" ]; then
  export SDL_JOYSTICK_ALLOW_BACKGROUND_EVENTS=1
fi

# Games list from the handheld and any microSD card, as they are right now (emulation layer).
[ -x /usr/bin/steamling-roms-sync ] && /usr/bin/steamling-roms-sync

# The unpacked AppImage (see the PKGBUILD): its binary finds its libraries and resources from
# its own path, as it does inside the AppImage.
exec /opt/steamling/es-de/app/usr/bin/es-de "$@"
