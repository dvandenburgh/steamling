# es-de — the ES-DE frontend, vendored from upstream's official aarch64 AppImage. A source
# build is not an option: it hard-depends on freeimage, which ALARM has no aarch64 build of.
# ES-DE moved its downloads off GitLab to packages.es-de.org, one folder per release; a new
# version is the same URL with the version changed, and a new sha256.
pkgname=es-de
pkgver=3.5.0
pkgrel=3
pkgdesc="ES-DE frontend for browsing and launching games (official aarch64 AppImage, unpacked)"
arch=('aarch64')
url="https://es-de.org"
license=('MIT')
provides=('emulationstation-de')
conflicts=('emulationstation-de')
# What the unpacked binary and the libraries it bundles load from the system (ldd on the RP6).
depends=('alsa-lib' 'fontconfig' 'freetype2' 'fribidi' 'harfbuzz' 'graphite' 'libdrm' 'libx11' 'libxcb'
         'libxau' 'libxdmcp' 'expat' 'gmp' 'e2fsprogs' 'libgpg-error' 'zlib' 'libstdc++' 'libgcc')
makedepends=('squashfs-tools')
options=('!strip')
source=("ES-DE-${pkgver}.AppImage::https://packages.es-de.org/release/${pkgver}/ES-DE_aarch64.AppImage"
        'es-de-wrapper'
        'es-de.desktop'
        'es-de-icon.png')
sha256sums=('b6d34657842db89628d5bc42ed465b605108b45cb1d16b15332d6c9f60136a4b' 'SKIP' 'SKIP' 'SKIP')
noextract=("ES-DE-${pkgver}.AppImage")

# Unpacked here instead of run as an AppImage. A running AppImage reads its own files through a
# FUSE helper process, and Steam's Exit Game stops the helper along with ES-DE: when the helper went
# first, ES-DE lost its code mid-shutdown and died of SIGBUS, every time, before it could save.
build() {
  cd "${srcdir}"
  rm -rf squashfs-root AppDir app
  # Unpacked with unsquashfs, not by running the AppImage: the build chroot runs it under
  # qemu-user, where its runtime reads qemu instead of itself and finds nothing to extract. The
  # image starts right after the runtime's ELF section headers.
  local f="ES-DE-${pkgver}.AppImage" shoff shentsize shnum off
  shoff=$(od -An -t u8 -j 40 -N 8 "${f}" | tr -d ' ')
  shentsize=$(od -An -t u2 -j 58 -N 2 "${f}" | tr -d ' ')
  shnum=$(od -An -t u2 -j 60 -N 2 "${f}" | tr -d ' ')
  off=$((shoff + shentsize * shnum))
  [ "$(dd if="${f}" bs=1 skip="${off}" count=4 2>/dev/null)" = hsqs ] \
    || { echo "es-de: no squashfs image at byte ${off} of ${f}" >&2; return 1; }
  unsquashfs -q -n -o "${off}" -d app "${f}" >/dev/null
  [ -x app/usr/bin/es-de ] || { echo "es-de: the unpacked image has no usr/bin/es-de" >&2; return 1; }
}

package() {
  install -d "${pkgdir}/opt/steamling/es-de"
  cp -a "${srcdir}/app" "${pkgdir}/opt/steamling/es-de/app"
  install -Dm755 "${srcdir}/es-de-wrapper" "${pkgdir}/usr/bin/es-de"
  # The AppImage hides its icon inside the squashfs, so the desktop entry needs its own copy.
  install -Dm644 "${srcdir}/es-de-icon.png" "${pkgdir}/opt/steamling/es-de/icon.png"
  install -Dm644 "${srcdir}/es-de.desktop" "${pkgdir}/usr/share/applications/es-de.desktop"
}
