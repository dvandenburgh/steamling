# Build with ./nodeps: makepkg -s would drag all of KDE/Qt into the chroot for a data package.
pkgname=steamling-desktop-plasma
pkgver=0.1.1
pkgrel=1
pkgdesc="steamling desktop flavour: Plasma (desktop shell)"
arch=('any')
url="https://github.com/dvandenburgh/steamling"
license=('GPL-2.0-or-later')
depends=('steamling-desktop>=0.1.0-30'   # first picker that offers the plasma session
         'steamling-desktop-kde>=0.1.0-2.1'  # owns the /etc/xdg/kwinrc that picks plasma-keyboard from -2.1
         'plasma-desktop'               # the org.kde.plasma.desktop shell; plasma.desktop alone is not enough
         'systemsettings'
         'kmenuedit'
         'polkit-kde-agent'
         'plasma-keyboard'
         'steamos-vapor-theme')
provides=('steamling-desktop-flavour')
source=('kdeglobals' 'konsolerc')
sha256sums=('SKIP' 'SKIP')

package() {
  install -Dm644 "${srcdir}/kdeglobals" "${pkgdir}/etc/xdg/kdeglobals"
  install -Dm644 "${srcdir}/konsolerc"  "${pkgdir}/etc/xdg/konsolerc"
}
