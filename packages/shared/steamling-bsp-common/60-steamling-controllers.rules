# Controller uaccess for the deck session: Arch's game-devices-udev rules are not in the ALARM
# repos and native ARM Steam ships none, so nothing grants them. deck is in `input` and can read
# evdev already; the gap is /dev/hidraw* (root:root 0600), which Steam Input needs for the full
# controller. Without uinput write, input works in the Steam UI but NOT in-game.
KERNEL=="uinput", SUBSYSTEM=="misc", MODE="0660", GROUP="input", OPTIONS+="static_node=uinput"

# 28de = Valve: Steam Controller, Steam Deck, and InputPlumber's Deck targets. Matched on the
# HID node name: the uhid `deck-uhid` pad has no USB idVendor.
KERNEL=="hidraw*", KERNELS=="000[356]:28DE:*", GROUP="input", MODE="0660", TAG+="uaccess"
SUBSYSTEM=="input", KERNELS=="000[356]:28DE:*", MODE="0660", TAG+="uaccess"

# Two matches per vendor. ATTRS{idVendor} covers USB pads, including those with no HID node at
# all (xpad's wired Xbox pads). A Bluetooth pad has no USB idVendor, so that match missed every
# wireless one and Steam Input fell back to the bare gamepad (no gyro, no rumble); the HID node's
# own name, 0005:<vendor>:<product>, carries the vendor for those.
# Sony (DualShock 3/4, DualSense)
KERNEL=="hidraw*", ATTRS{idVendor}=="054c", MODE="0660", TAG+="uaccess"
SUBSYSTEM=="input", ATTRS{idVendor}=="054c", MODE="0660", TAG+="uaccess"
KERNEL=="hidraw*", KERNELS=="0005:054C:*", MODE="0660", TAG+="uaccess"
SUBSYSTEM=="input", KERNELS=="0005:054C:*", MODE="0660", TAG+="uaccess"
# Microsoft (Xbox)
KERNEL=="hidraw*", ATTRS{idVendor}=="045e", MODE="0660", TAG+="uaccess"
SUBSYSTEM=="input", ATTRS{idVendor}=="045e", MODE="0660", TAG+="uaccess"
KERNEL=="hidraw*", KERNELS=="0005:045E:*", MODE="0660", TAG+="uaccess"
SUBSYSTEM=="input", KERNELS=="0005:045E:*", MODE="0660", TAG+="uaccess"
# Nintendo (Switch Pro / Joy-Con, and third-party pads in Switch mode, which report as a Pro
# Controller, 057E:2009)
KERNEL=="hidraw*", ATTRS{idVendor}=="057e", MODE="0660", TAG+="uaccess"
SUBSYSTEM=="input", ATTRS{idVendor}=="057e", MODE="0660", TAG+="uaccess"
KERNEL=="hidraw*", KERNELS=="0005:057E:*", MODE="0660", TAG+="uaccess"
SUBSYSTEM=="input", KERNELS=="0005:057E:*", MODE="0660", TAG+="uaccess"
# 8BitDo
KERNEL=="hidraw*", ATTRS{idVendor}=="2dc8", MODE="0660", TAG+="uaccess"
SUBSYSTEM=="input", ATTRS{idVendor}=="2dc8", MODE="0660", TAG+="uaccess"
KERNEL=="hidraw*", KERNELS=="0005:2DC8:*", MODE="0660", TAG+="uaccess"
SUBSYSTEM=="input", KERNELS=="0005:2DC8:*", MODE="0660", TAG+="uaccess"
