#!/bin/sh
# steamling-gamepad-target — which virtual pad InputPlumber publishes for this session. The Deck
# targets are hidraw-only like real Deck hardware and publish no evdev joystick, so outside Steam
# nothing sees a pad; desktop mode asks for `xb360`. Every InputPlumber start re-reads its YAML
# (always `deck-uhid`), so the choice must be replayed after one, not just at session launch.
set -u

SERVICE=org.shadowblip.InputPlumber
IFACE=org.shadowblip.Input.CompositeDevice
STATE=/run/steamling/gamepad-target

# Non-pad targets must survive the swap: the keyboard one re-emits the volume rocker off the
# gpio-keys node InputPlumber holds exclusively.
is_pad_kind() {
  case "$1" in
    deck|deck-uhid|xb360|xbox-elite|xbox-series|ds5|ds5-edge|horipad-steam|gamepad|steam-deck) return 0 ;;
    *) return 1 ;;
  esac
}

composites() {
  busctl --system tree "${SERVICE}" 2>/dev/null \
    | grep -o '/org/shadowblip/InputPlumber/CompositeDevice[0-9]\+' | sort -u
}

kind_of() {
  busctl --system get-property "${SERVICE}" "$1" org.shadowblip.Input.Target DeviceType 2>/dev/null \
    | sed -n 's/^s "\(.*\)"$/\1/p'
}

usage() { echo "usage: steamling-gamepad-target <kind>|--apply" >&2; exit 2; }

PROFILE=/etc/steamling/gamepad-profile.json

# Governor's back-paddle mapping is an InputPlumber profile, and InputPlumber starts
# every composite on its stock one, so it is loaded again here.
load_profile() {
  [ -r "${PROFILE}" ] || return 0
  for path in $(composites); do
    busctl --system call "${SERVICE}" "${path}" "${IFACE}" LoadProfilePath s "${PROFILE}" >/dev/null 2>&1 \
      || echo "steamling-gamepad-target: failed to load ${PROFILE} on ${path}" >&2
  done
}

case "${1:-}" in
  --apply)
    KIND="$(cat "${STATE}" 2>/dev/null)" || KIND="" ;;
  -*|"")
    usage ;;
  *)
    KIND="$1"
    mkdir -p /run/steamling 2>/dev/null || true
    printf '%s\n' "${KIND}" > "${STATE}" 2>/dev/null || true ;;
esac
[ -n "${KIND}" ] || [ -r "${PROFILE}" ] || exit 0

# Composites appear a moment after the bus name does (udev enumeration), so ordering behind
# inputplumber.service is not enough to find one.
i=0
while [ -z "$(composites)" ]; do
  i=$((i + 1))
  [ "${i}" -ge 100 ] && exit 0
  sleep 0.1
done

[ "${1:-}" = --apply ] && load_profile
[ -n "${KIND}" ] || exit 0

targets_of() {
  busctl --system get-property "${SERVICE}" "$1" "${IFACE}" TargetDevices 2>/dev/null \
    | grep -o '"[^"]*"' | tr -d '"'
}

for path in $(composites); do
  # InputPlumber creates a composite's targets one by one after the composite itself, so
  # right after a start the list can be empty or missing the keyboard. Wait for the first
  # one, and always keep the keyboard (every Steamling controller config has one), or a
  # replay that lands mid-creation drops it and the volume rocker goes dead.
  j=0
  targets="$(targets_of "${path}")"
  while [ -z "${targets}" ] && [ "${j}" -lt 30 ]; do
    j=$((j + 1))
    sleep 0.1
    targets="$(targets_of "${path}")"
  done
  have_pad=0
  keep="keyboard"
  for t in ${targets}; do
    k="$(kind_of "${t}")"
    [ -n "${k}" ] || continue
    if is_pad_kind "${k}"; then
      have_pad=1
    else
      case " ${keep} " in *" ${k} "*) ;; *) keep="${keep} ${k}" ;; esac
    fi
  done
  [ "${have_pad}" = 1 ] || continue

  set -- "${KIND}" ${keep}
  busctl --system call "${SERVICE}" "${path}" "${IFACE}" SetTargetDevices as "$#" "$@" >/dev/null 2>&1 \
    || echo "steamling-gamepad-target: failed to set ${KIND} on ${path}" >&2
done
exit 0
