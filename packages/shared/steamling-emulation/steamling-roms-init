#!/bin/bash
# steamling-roms-init - login-time setup for the emulation layer, run as 'deck' by its user unit.
# Seeds go through steamling-seed-merge. Every step is guarded: a failure must never fail a login.
set -u

SHARE=/usr/share/steamling-emulation
PREV=/var/lib/steamling/seed-prev
MERGE=/usr/lib/steamling/steamling-seed-merge
EMU="${HOME}/Emulation"
. /usr/lib/steamling/emu-resolve.sh
MODE=merge
STATE="${XDG_STATE_HOME:-${HOME}/.local/state}"

# Seeds are authored for a 120Hz, 1080-line panel and adapted below; absent keys pass them through.
[ -r /usr/lib/steamling/device.conf ] && . /usr/lib/steamling/device.conf
[ -r /etc/steamling/device.conf ] && . /etc/steamling/device.conf
REFRESH="${STEAMLING_PANEL_REFRESH:-120}"
# device.conf carries the NATIVE frame; rotated panels are transposed to get the logical height.
case "${STEAMLING_PANEL_ORIENT:-left}" in
  left|right) LOGICAL_H="${STEAMLING_PANEL_W:-1080}" ;;
  *)          LOGICAL_H="${STEAMLING_PANEL_H:-1920}" ;;
esac
# ES-DE's ROMDirectory setting is the single source of truth for where ROMs live; this skeleton
# and steamling-steam-sync both follow it. Ours is ~/Emulation/Library, which steamling-roms-sync
# fills with links to the games in ~/Emulation/ROMs and on any microSD card. Empty/absent means
# ES-DE's own default ~/ROMs. The settings file is a rootless XML fragment, hence sed.
ESDE_SETTINGS="${HOME}/ES-DE/settings/es_settings.xml"
ESDE_CUSTOM="${HOME}/ES-DE/custom_systems"
_roms_setting="$(sed -n 's/.*name="ROMDirectory" value="\([^"]*\)".*/\1/p' "${ESDE_SETTINGS}" 2>/dev/null | head -1)"
case "${_roms_setting}" in "~"*) _roms_setting="${HOME}${_roms_setting#\~}" ;; esac
LIBRARY="${EMU}/Library"
# ~/Emulation/ROMs was the default before the handheld and the card were combined: move it to
# Library, where those games still show. A folder the user picked is left alone. ES-DE writes its
# settings when it closes, so this waits for a login where it isn't running.
if [ "${_roms_setting}" = "${EMU}/ROMs" ] && ! pgrep -x es-de >/dev/null; then
  sed -i "s|<string name=\"ROMDirectory\" value=\"[^\"]*\" */>|<string name=\"ROMDirectory\" value=\"${LIBRARY}\" />|" "${ESDE_SETTINGS}" \
    && _roms_setting="${LIBRARY}"
fi
if [ -n "${_roms_setting}" ]; then
  ROMS="${_roms_setting}"
elif [ -f "${ESDE_SETTINGS}" ]; then
  ROMS="${HOME}/ROMs"          # settings exist but no/empty ROMDirectory = ES-DE default
else
  ROMS="${LIBRARY}"            # fresh install: the seed below points ES-DE here
fi

have_esde()      { command -v es-de >/dev/null 2>&1; }
have_retroarch() { command -v retroarch >/dev/null 2>&1; }
have_armsx2()    { emu_path armsx2 >/dev/null 2>&1; }
have_eden()      { emu_path eden >/dev/null 2>&1; }
have_dolphin()   { emu_path dolphin >/dev/null 2>&1; }
have_cemu()      { emu_path cemu >/dev/null 2>&1; }
have_ppsspp()    { emu_path ppsspp >/dev/null 2>&1; }
have_ryujinx()   { emu_path ryujinx >/dev/null 2>&1; }
EMULATORS=(esde retroarch armsx2 eden ryujinx dolphin cemu ppsspp)

TMP="$(mktemp -d "${XDG_RUNTIME_DIR:-/tmp}/steamling-seed.XXXXXX")" || exit 0
trap 'rm -rf "${TMP}"' EXIT

have_merge() { command -v python3 >/dev/null 2>&1 && [ -x "${MERGE}" ]; }
# Run on the shipped templates and, when the install hook stashed them, the previous
# package's, which stand in as the baseline where no per-user one exists.
render_all() {  # $1 template dir, $2 out dir
  local src="$1" out="$2"; mkdir -p "${out}"
  printf '<?xml version="1.0"?>\n<string name="ROMDirectory" value="%s" />\n' "${ROMS}" > "${out}/es_settings.xml"
  local si=$(( REFRESH / 60 )); [ "${si}" -lt 1 ] && si=1
  local hdr=true nits="${STEAMLING_PANEL_HDR_NITS:-0}"
  case "${nits}" in ''|0|*[!0-9]*) hdr=false; nits=1000 ;; esac
  [ -f "${src}/retroarch.cfg" ] && sed -e "s/^video_refresh_rate = .*/video_refresh_rate = \"${REFRESH}.000000\"/" \
      -e "s/^video_swap_interval = .*/video_swap_interval = \"${si}\"/" \
      -e "s/^video_hdr_enable = .*/video_hdr_enable = \"${hdr}\"/" \
      -e "s/^video_hdr_max_nits = .*/video_hdr_max_nits = \"${nits}.000000\"/" "${src}/retroarch.cfg" > "${out}/retroarch.cfg"
  [ -f "${src}/armsx2-PCSX2.ini.in" ] && sed "s|__HOME__|${HOME}|g" "${src}/armsx2-PCSX2.ini.in" > "${out}/PCSX2.ini"
  local vs=2; [ "${REFRESH}" -ge 120 ] 2>/dev/null && vs=1
  [ -f "${src}/eden-qt-config.ini.in" ] && sed "s/^use_vsync=.*/use_vsync=${vs}/" "${src}/eden-qt-config.ini.in" > "${out}/qt-config.ini"
  [ -f "${src}/ryujinx-Config.json.in" ] && sed "s|__ROMS__|${ROMS}|g" "${src}/ryujinx-Config.json.in" > "${out}/Config.json"
  [ -f "${src}/dolphin-Dolphin.ini.in" ] && cp "${src}/dolphin-Dolphin.ini.in" "${out}/Dolphin.ini"
  [ -f "${src}/dolphin-GFX.ini.in" ] && cp "${src}/dolphin-GFX.ini.in" "${out}/GFX.ini"
  [ -f "${src}/cemu-settings.xml.in" ] && sed "s|__ROMS__|${ROMS}|g" "${src}/cemu-settings.xml.in" > "${out}/settings.xml"
  # the largest 272-row multiple that fits the panel, +8 rows slack (4x on 1080 crops 8)
  local res=$(( (LOGICAL_H + 8) / 272 )); [ "${res}" -lt 1 ] && res=1
  [ -f "${src}/ppsspp.ini.in" ] && sed "s/^iInternalResolution = .*/iInternalResolution = ${res}/" "${src}/ppsspp.ini.in" > "${out}/ppsspp.ini"
  return 0
}
render_all "${SHARE}" "${TMP}/new"
[ -d "${PREV}" ] && render_all "${PREV}" "${TMP}/prev"

seed_b() {  # $1 format, $2 rendered name, $3 target, $4 policy name (optional)
  local policy=() fb=()
  [ -n "${4:-}" ] && [ -f "${SHARE}/$4.policy" ] && policy=(--policy "${SHARE}/$4.policy")
  [ -f "${TMP}/prev/$2" ] && fb=(--baseline "${TMP}/prev/$2")
  mkdir -p "$(dirname "$3")" 2>/dev/null || return 0
  if have_merge; then
    "${MERGE}" --class b --format "$1" --mode "${MODE}" ${policy[@]+"${policy[@]}"} ${fb[@]+"${fb[@]}"} "${TMP}/new/$2" "$3" 2>&1 || true
  else
    [ -f "$3" ] || cp "${TMP}/new/$2" "$3" 2>/dev/null || true
  fi
}
seed_a() {  # $1 file or dir (absolute, or relative to SHARE), $2 target
  local src="$1" fb=()
  case "$1" in /*) ;; *) src="${SHARE}/$1"; [ -e "${PREV}/$1" ] && fb=(--baseline "${PREV}/$1") ;; esac
  mkdir -p "$(dirname "$2")" 2>/dev/null || return 0
  if have_merge; then
    "${MERGE}" --class a ${fb[@]+"${fb[@]}"} "${src}" "$2" 2>&1 || true
  elif [ -d "${src}" ]; then
    mkdir -p "$2"; cp -Rn "${src}/." "$2/" 2>/dev/null || true
  else
    [ -f "$2" ] || cp "${src}" "$2" 2>/dev/null || true
  fi
}

seed_esde() {
  seed_b esxml es_settings.xml "${ESDE_SETTINGS}" es_settings
  seed_a es_find_rules.xml "${ESDE_CUSTOM}/es_find_rules.xml"
  seed_a es_systems.xml "${ESDE_CUSTOM}/es_systems.xml"
}

seed_retroarch() {
  seed_b racfg retroarch.cfg "${HOME}/.config/retroarch/retroarch.cfg" retroarch
  # RetroArch's own autoconfig dir, so user-saved profiles coexist; without these the Steam
  # Input pad has no bindings at all.
  [ -d /usr/share/libretro/autoconfig/udev ] && \
    seed_a /usr/share/libretro/autoconfig/udev "${HOME}/.config/retroarch/autoconfig/udev"
  # Linked, not copied; the dir stays writable so preset saving works. A real
  # shaders_slang (Online Updater) wins.
  local shaders="${HOME}/.config/retroarch/shaders/shaders_slang"
  if [ -d /usr/share/libretro/shaders/shaders_slang ] && [ ! -e "${shaders}" ]; then
    mkdir -p "${HOME}/.config/retroarch/shaders"
    ln -s /usr/share/libretro/shaders/shaders_slang "${shaders}" 2>/dev/null || true
  fi
  [ -d "${SHARE}/retroarch-config" ] && seed_a retroarch-config "${HOME}/.config/retroarch/config"
}

seed_armsx2() {
  # The PCSX2 -> ARMSX2 dir migration must precede the seed, or an upgraded device gets a
  # fresh seed, the setup wizard and orphaned memcards.
  if [ -f "${HOME}/.config/PCSX2/inis/PCSX2.ini" ] && [ ! -f "${HOME}/.config/ARMSX2/inis/PCSX2.ini" ]; then
    mkdir -p "${HOME}/.config/ARMSX2"
    cp -a "${HOME}/.config/PCSX2/." "${HOME}/.config/ARMSX2/" 2>/dev/null || true
  fi
  seed_b ini PCSX2.ini "${HOME}/.config/ARMSX2/inis/PCSX2.ini" armsx2-PCSX2
}

# Mailbox vsync (1) is bouncy on 60Hz panels, so those get FIFO (2)
seed_eden()    { seed_b ini qt-config.ini "${HOME}/.config/eden/qt-config.ini" eden-qt-config; }
seed_ryujinx() { seed_b json Config.json "${HOME}/.config/Ryujinx/Config.json" ryujinx-Config; }

seed_dolphin() {
  seed_b ini Dolphin.ini "${HOME}/.config/dolphin-emu/Dolphin.ini"
  seed_b ini GFX.ini     "${HOME}/.config/dolphin-emu/GFX.ini"
  seed_a dolphin-GCPadNew.ini.in "${HOME}/.config/dolphin-emu/GCPadNew.ini"
}

seed_cemu() {
  # The file merely existing is what skips Cemu's onboarding wizard (CemuApp isFirstStart);
  # the controller profile is session-dependent, so steamling-cemu-profile writes it at launch.
  seed_b xml settings.xml "${HOME}/.config/Cemu/settings.xml" cemu-settings
}

seed_ppsspp() { seed_b ini ppsspp.ini "${HOME}/.config/ppsspp/PSP/SYSTEM/ppsspp.ini"; }

# ROMS was read before any reset, so restoring ES-DE defaults keeps the user's ROM location
label() {
  local l own=""
  case "$1" in
    esde) l="ES-DE frontend" ;;          retroarch) l="RetroArch" ;;
    armsx2) l="ARMSX2 (PS2)" ;;          eden) l="Eden (Switch)" ;;
    dolphin) l="Dolphin (GameCube/Wii)" ;; cemu) l="Cemu (Wii U)" ;;
    ppsspp) l="PPSSPP (PSP)" ;;          ryujinx) l="Ryujinx (Switch)" ;;
  esac
  case "$(emu_path "$1" 2>/dev/null)" in "${EMU_DROP}"/*) own=" - your own build" ;; esac
  echo "${l}${own}"
}
STAMP="$(date +%Y%m%d-%H%M%S)"
reset_target() {  # $1 target file
  [ -e "$1" ] && mv "$1" "$1.bak-${STAMP}" 2>/dev/null
  rm -f "${STATE}/steamling/seed-baseline/${1#"${HOME}/"}" "$1.steamlingnew"
}
reset_dir() {  # $1 shipped dir, $2 target dir: only the files we ship, never the user's own
  local f
  [ -d "$1" ] || return 0
  while IFS= read -r f; do reset_target "$2/${f#"$1/"}"; done < <(find "$1" -type f)
}
reset_esde()      { reset_target "${ESDE_SETTINGS}"; reset_target "${ESDE_CUSTOM}/es_find_rules.xml"; reset_target "${ESDE_CUSTOM}/es_systems.xml"; }
reset_retroarch() {
  reset_target "${HOME}/.config/retroarch/retroarch.cfg"
  reset_dir /usr/share/libretro/autoconfig/udev "${HOME}/.config/retroarch/autoconfig/udev"
  reset_dir "${SHARE}/retroarch-config" "${HOME}/.config/retroarch/config"
}
reset_armsx2()    { reset_target "${HOME}/.config/ARMSX2/inis/PCSX2.ini"; }
reset_eden()      { reset_target "${HOME}/.config/eden/qt-config.ini"; }
reset_ryujinx()   { reset_target "${HOME}/.config/Ryujinx/Config.json"; }
reset_dolphin()   { local f; for f in Dolphin.ini GFX.ini GCPadNew.ini; do reset_target "${HOME}/.config/dolphin-emu/${f}"; done; }
reset_cemu()      { reset_target "${HOME}/.config/Cemu/settings.xml"; }
reset_ppsspp()    { reset_target "${HOME}/.config/ppsspp/PSP/SYSTEM/ppsspp.ini"; }

present=()
for e in "${EMULATORS[@]}"; do "have_${e}" && present+=("${e}"); done

case "${1:-}" in
  --list)
    for e in "${present[@]}"; do printf '%s\t%s\n' "${e}" "$(label "${e}")"; done
    exit 0 ;;
  --reset)
    shift
    [ "$#" -gt 0 ] || { echo "usage: steamling-roms-init --reset <${EMULATORS[*]// /|}|all>" >&2; exit 2; }
    [ "$1" = all ] && set -- "${present[@]}"
    for e in "$@"; do
      case " ${present[*]} " in *" ${e} "*) ;; *) echo "steamling-roms-init: ${e} is not installed" >&2; continue ;; esac
      "reset_${e}"; "seed_${e}" || true
    done
    exit 0 ;;
esac
# a layer-less device must not grow ~/Emulation or emulator config dirs
[ "${#present[@]}" -gt 0 ] || exit 0

mkdir -p "${EMU}/BIOS" "${EMU}/Saves" "${EMU}/States"
# The per-system folders, on the handheld and on any mounted card, and the links in Library.
steamling-roms-sync
# A ROM folder the user pointed ES-DE at themselves gets the folders too, except on a card that
# isn't mounted: an empty mount point is not the card.
if [ "${ROMS}" != "${LIBRARY}" ]; then
  _roms_here=1
  case "${ROMS}" in
    /run/media/*/*) mountpoint -q "$(printf '%s\n' "${ROMS}" | cut -d/ -f1-5)" || _roms_here=0 ;;
  esac
  [ "${_roms_here}" = 0 ] || while read -r s; do mkdir -p "${ROMS}/${s}"; done < <(steamling-roms-sync --systems)
fi
for e in ${EMU_NAMES}; do mkdir -p "${EMU_DROP}/${e}"; done
# Eden is not shipped any more: hand a device that has it its own copy (cruft.md)
if [ -x /opt/steamling/emulators/eden/Eden.AppImage ] && [ -z "$(ls -A "${EMU_DROP}/eden" 2>/dev/null)" ]; then
  cp /opt/steamling/emulators/eden/Eden.AppImage "${EMU_DROP}/eden/Eden.AppImage" 2>/dev/null || true
fi
# refreshed every run so doc updates reach existing installs
[ -f "${SHARE}/ROMS-README.txt" ] && cp -f "${SHARE}/ROMS-README.txt" "${EMU}/README.txt" 2>/dev/null

for e in "${present[@]}"; do "seed_${e}" || true; done
exit 0
