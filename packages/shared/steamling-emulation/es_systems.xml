<?xml version="1.0"?>
<!--
  steamling ES-DE custom system definitions, seeded to ~/ES-DE/custom_systems/ by steamling-roms-init.
  A custom entry REPLACES the bundled system of the same name, so every entry here must be the
  FULL definition, not a delta. Each one exists because the bundled default command names a core or
  standalone we do not ship: ps2 offers only the LRPS2 core, psx names a DuckStation standalone
  (ours is the SwanStation libretro core), gc/wii default to the RetroArch dolphin
  core; cps1/cps2/cps3/arcade/mame all default to mame_libretro, which we do not ship.
  All commands go through the /usr/lib/steamling/es-* wrappers: the big-core pin for the
  standalones, the frame-pacing pin (es-retroarch) for the libretro cores (psx and the
  arcade systems). n64, dreamcast and saturn are here only for that pin: the bundled entries
  launch RetroArch bare, and n64's ParaLLEl-RDP needs the Vulkan context the pin gives it. steamling-play mirrors these defaults for the Steam tiles.
  Our picks come first (the first command is the default), followed by every other RetroArch core
  the bundled definition offers, through the same wrapper: a replaced system would otherwise hide
  the alternatives, so a core downloaded in RetroArch's Core Downloader could never be picked.
-->
<systemList>
    <system>
        <name>gc</name>
        <fullname>Nintendo GameCube</fullname>
        <path>%ROMPATH%/gc</path>
        <extension>.ciso .CISO .dff .DFF .dol .DOL .elf .ELF .gcm .GCM .gcz .GCZ .iso .ISO .json .JSON .m3u .M3U .rvz .RVZ .tgc .TGC .wad .WAD .wbfs .WBFS .wia .WIA .7z .7Z .zip .ZIP</extension>
        <command label="Dolphin">/usr/lib/steamling/es-dolphin -b -e %ROM%</command>
        <command label="Dolphin (RetroArch)">/usr/lib/steamling/es-retroarch -L %CORE_RETROARCH%/dolphin_libretro.so %ROM%</command>
        <command label="Shortcut or script">%ENABLESHORTCUTS% %EMULATOR_OS-SHELL% %ROM%</command>
        <platform>gc</platform>
        <theme>gc</theme>
    </system>
    <system>
