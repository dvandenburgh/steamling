# steamling-emulation — the "drop ROMs in and play" layer: ES-DE + preconfigured emulator
# configs, shipped as an arch=any data/scripts package.
pkgname=steamling-emulation
pkgver=0.1.1
pkgrel=8
pkgdesc="ES-DE + preconfigured emulators: drop ROMs into ~/Emulation and play; star -> Steam"
arch=('any')
url="https://github.com/dvandenburgh/steamling"
license=('GPL-2.0-or-later')
# Build with ./nodeps: the meta dep would drag ES-DE/RetroArch/Qt into the chroot. The meta dep
# is the pre-meta catch-up cycle, see steamling-steam.
depends=('bash' 'steamling-emulation-full' 'steamling-bsp-common>=0.1.0-24')
install=steamling-emulation.install
source=('steamling-roms-init' 'steamling-roms-init.service' 'steamling-seed-merge' 'steamling-play' 'steamling-roms-sync' 'steamling-roms-sync.service'
        'emu-resolve.sh' 'es-eden' 'es-ryujinx' 'es-armsx2' 'es-dolphin' 'es-psp' 'es-xemu' 'es-retroarch'
        'retroarch-SwanStation-SwanStation.opt' 'retroarch-Mupen64Plus-Next-Mupen64Plus-Next.opt'
        'es-azahar' 'es-rpcs3' 'es-cemu' 'es-vita3k'
        'es_find_rules.xml' 'es_systems.xml' 'retroarch.cfg' 'ROMS-README.txt' 'armsx2-PCSX2.ini.in'
        'eden-qt-config.ini.in' 'ppsspp.ini.in' 'ryujinx-Config.json.in'
        'cemu-settings.policy' 'armsx2-PCSX2.policy' 'eden-qt-config.policy' 'retroarch.policy' 'es_settings.policy'
        'ryujinx-Config.policy'
        'steamling-cemu-profile' 'cemu-settings.xml.in' 'cemu-controller0.xml.in'
        'dolphin-Dolphin.ini.in' 'dolphin-GFX.ini.in' 'dolphin-GCPadNew.ini.in'
        # FLAT names: makepkg cannot retrieve local sources from subdirectory paths, so
        # package() maps retroarch-<Core>-<file> back into the retroarch-config/<Core>/ tree.
        'retroarch-mGBA-gba.cfg' 'retroarch-mGBA-gba.slangp')
sha256sums=('SKIP' 'SKIP' 'SKIP' 'SKIP' 'SKIP' 'SKIP' 'SKIP' 'SKIP' 'SKIP' 'SKIP' 'SKIP' 'SKIP' 'SKIP' 'SKIP' 'SKIP' 'SKIP' 'SKIP' 'SKIP' 'SKIP' 'SKIP' 'SKIP' 'SKIP' 'SKIP' 'SKIP' 'SKIP' 'SKIP' 'SKIP' 'SKIP' 'SKIP' 'SKIP' 'SKIP' 'SKIP' 'SKIP' 'SKIP' 'SKIP' 'SKIP' 'SKIP' 'SKIP' 'SKIP' 'SKIP' 'SKIP' 'SKIP')

package() {
  install -Dm755 "${srcdir}/steamling-roms-init" "${pkgdir}/usr/bin/steamling-roms-init"
  install -Dm755 "${srcdir}/steamling-seed-merge" "${pkgdir}/usr/lib/steamling/steamling-seed-merge"
  install -Dm755 "${srcdir}/steamling-play"      "${pkgdir}/usr/bin/steamling-play"
  install -Dm755 "${srcdir}/steamling-roms-sync" "${pkgdir}/usr/bin/steamling-roms-sync"
  install -Dm644 "${srcdir}/steamling-roms-sync.service" \
    "${pkgdir}/usr/lib/systemd/user/steamling-roms-sync.service"

  install -Dm644 "${srcdir}/emu-resolve.sh" "${pkgdir}/usr/lib/steamling/emu-resolve.sh"
  install -Dm755 "${srcdir}/es-eden"    "${pkgdir}/usr/lib/steamling/es-eden"
  install -Dm755 "${srcdir}/es-ryujinx" "${pkgdir}/usr/lib/steamling/es-ryujinx"
  install -Dm755 "${srcdir}/es-armsx2"  "${pkgdir}/usr/lib/steamling/es-armsx2"
  install -Dm755 "${srcdir}/es-psp"     "${pkgdir}/usr/lib/steamling/es-psp"
  install -Dm755 "${srcdir}/es-retroarch" "${pkgdir}/usr/lib/steamling/es-retroarch"
  install -Dm755 "${srcdir}/es-xemu"    "${pkgdir}/usr/lib/steamling/es-xemu"
  install -Dm755 "${srcdir}/es-azahar"  "${pkgdir}/usr/lib/steamling/es-azahar"
  install -Dm755 "${srcdir}/es-rpcs3"   "${pkgdir}/usr/lib/steamling/es-rpcs3"
  install -Dm755 "${srcdir}/es-cemu"    "${pkgdir}/usr/lib/steamling/es-cemu"
  install -Dm755 "${srcdir}/es-vita3k"  "${pkgdir}/usr/lib/steamling/es-vita3k"
  install -Dm755 "${srcdir}/es-dolphin" "${pkgdir}/usr/lib/steamling/es-dolphin"

  install -Dm644 "${srcdir}/steamling-roms-init.service" \
    "${pkgdir}/usr/lib/systemd/user/steamling-roms-init.service"
  # enabled by a packaged wants link, so removing the layer removes the autostart with it
  install -d "${pkgdir}/usr/lib/systemd/user/default.target.wants"
  ln -s ../steamling-roms-init.service \
    "${pkgdir}/usr/lib/systemd/user/default.target.wants/steamling-roms-init.service"

  install -Dm644 "${srcdir}/es_find_rules.xml" \
    "${pkgdir}/usr/share/steamling-emulation/es_find_rules.xml"
  install -Dm644 "${srcdir}/es_systems.xml" \
    "${pkgdir}/usr/share/steamling-emulation/es_systems.xml"
  install -Dm644 "${srcdir}/retroarch.cfg" \
    "${pkgdir}/usr/share/steamling-emulation/retroarch.cfg"
  install -Dm644 "${srcdir}/ROMS-README.txt" \
    "${pkgdir}/usr/share/steamling-emulation/ROMS-README.txt"
  install -Dm644 "${srcdir}/armsx2-PCSX2.ini.in" \
    "${pkgdir}/usr/share/steamling-emulation/armsx2-PCSX2.ini.in"
  install -Dm644 "${srcdir}/eden-qt-config.ini.in" \
    "${pkgdir}/usr/share/steamling-emulation/eden-qt-config.ini.in"
  install -Dm644 "${srcdir}/ppsspp.ini.in" \
    "${pkgdir}/usr/share/steamling-emulation/ppsspp.ini.in"
  install -Dm644 "${srcdir}/ryujinx-Config.json.in" \
    "${pkgdir}/usr/share/steamling-emulation/ryujinx-Config.json.in"
  local pol
  for pol in cemu-settings armsx2-PCSX2 eden-qt-config retroarch es_settings ryujinx-Config; do
    install -Dm644 "${srcdir}/${pol}.policy" "${pkgdir}/usr/share/steamling-emulation/${pol}.policy"
  done
  install -Dm755 "${srcdir}/steamling-cemu-profile" "${pkgdir}/usr/lib/steamling/steamling-cemu-profile"
  install -Dm644 "${srcdir}/cemu-settings.xml.in" \
    "${pkgdir}/usr/share/steamling-emulation/cemu-settings.xml.in"
  install -Dm644 "${srcdir}/cemu-controller0.xml.in" \
    "${pkgdir}/usr/share/steamling-emulation/cemu-controller0.xml.in"
  install -Dm644 "${srcdir}/dolphin-Dolphin.ini.in" \
    "${pkgdir}/usr/share/steamling-emulation/dolphin-Dolphin.ini.in"
  install -Dm644 "${srcdir}/dolphin-GFX.ini.in" \
    "${pkgdir}/usr/share/steamling-emulation/dolphin-GFX.ini.in"
  install -Dm644 "${srcdir}/dolphin-GCPadNew.ini.in" \
    "${pkgdir}/usr/share/steamling-emulation/dolphin-GCPadNew.ini.in"
  install -Dm644 "${srcdir}/retroarch-mGBA-gba.cfg"    "${pkgdir}/usr/share/steamling-emulation/retroarch-config/mGBA/gba.cfg"
  install -Dm644 "${srcdir}/retroarch-mGBA-gba.slangp" "${pkgdir}/usr/share/steamling-emulation/retroarch-config/mGBA/gba.slangp"
  # SwanStation's own renderer option; "OpenGL" drags the session onto GL (see es-retroarch).
  install -Dm644 "${srcdir}/retroarch-SwanStation-SwanStation.opt" "${pkgdir}/usr/share/steamling-emulation/retroarch-config/SwanStation/SwanStation.opt"
  # N64 on ParaLLEl-RDP and ParaLLEl-RSP (Vulkan); es-retroarch follows the RDP choice.
  install -Dm644 "${srcdir}/retroarch-Mupen64Plus-Next-Mupen64Plus-Next.opt" \
    "${pkgdir}/usr/share/steamling-emulation/retroarch-config/Mupen64Plus-Next/Mupen64Plus-Next.opt"
}
