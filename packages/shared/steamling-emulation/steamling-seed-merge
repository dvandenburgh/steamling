#!/usr/bin/env python3
# steamling-seed-merge - applies one rendered config seed to a user file without losing the user's
# edits. Emulators rewrite their own files on exit (geometry, volumes, recents), so "unchanged"
# is decided per key against the seed we last applied (the baseline), never by hashing the file.
import argparse
import fnmatch
import json
import os
import re
import sys
import xml.etree.ElementTree as ET

HOME = os.path.expanduser("~")
STATE = os.environ.get("XDG_STATE_HOME") or os.path.join(HOME, ".local/state")
BASE_DIR = os.path.join(STATE, "steamling/seed-baseline")
DRY = False


def short(path):
    return os.path.relpath(path, HOME) if path.startswith(HOME + "/") else path


def log(path, msg):
    print(f"seed-merge: {short(path)}: {msg}")


def baseline_for(dst):
    rel = os.path.relpath(dst, HOME) if dst.startswith(HOME + "/") else dst.lstrip("/")
    return os.path.join(BASE_DIR, rel)


def read(path):
    try:
        with open(path, "rb") as f:
            return f.read()
    except OSError:
        return None


def write(path, data, like=None):
    if DRY:
        return
    os.makedirs(os.path.dirname(path), exist_ok=True)
    tmp = path + ".steamling-tmp"
    with open(tmp, "wb") as f:
        f.write(data)
    if like is not None and os.path.exists(like):
        os.chmod(tmp, os.stat(like).st_mode & 0o7777)
    os.replace(tmp, path)


def remove(path):
    if DRY:
        return
    try:
        os.unlink(path)
    except FileNotFoundError:
        pass



def class_a_file(src, dst, fallback=None):
    new = read(src)
    if new is None:
        return
    cur, base = read(dst), baseline_for(dst)
    old, pn = read(base), dst + ".steamlingnew"
    if old is None and fallback:
        old = read(fallback)
    if cur is None:
        write(dst, new)
        log(dst, "seeded")
    elif cur == new:
        # still record it: a user who copied .steamlingnew over the file would otherwise
        # keep the older baseline and have every later default treated as their own edit
        remove(pn)
        if read(base) != new:
            write(base, new)
        return "current"
    elif old is not None and cur == old:
        write(dst, new, like=dst)
        remove(pn)
        log(dst, "updated to the new default")
    else:
        if read(pn) != new:
            write(pn, new)
        log(dst, "user-modified, kept; new default offered as .steamlingnew")
    write(base, new)


def class_a(src, dst, fallback=None):
    if not os.path.isdir(src):
        class_a_file(src, dst, fallback)
        return
    # a directory of pad profiles is hundreds of files: log the changes, count the rest
    current = 0
    for root, _, files in os.walk(src):
        for fn in sorted(files):
            s = os.path.join(root, fn)
            rel = os.path.relpath(s, src)
            fb = os.path.join(fallback, rel) if fallback else None
            if os.path.isfile(s) and class_a_file(s, os.path.join(dst, rel), fb) == "current":
                current += 1
    if current:
        log(dst, f"{current} file(s) current")



class LineDoc:
    """INI, retroarch.cfg and ES-DE's rootless es_settings.xml: one key per line, so edits keep
    the user's comments, order and unknown lines byte-for-byte."""
    KEY_RE = re.compile(r'^(\s*)([^=;#\[\s][^=]*?)(\s*=\s*)(.*?)(\s*)$')
    ES_RE = re.compile(r'^(\s*<\w+\s+name=")([^"]*)("\s+value=")([^"]*)("\s*/>\s*)$')

    def __init__(self, data, esxml=False):
        self.esxml = esxml
        self.lines = data.decode("utf-8", errors="surrogateescape").split("\n")
        self.index()

    def match(self, line):
        return (self.ES_RE if self.esxml else self.KEY_RE).match(line)

    def index(self):
        self.keys, self.section_of, self.section_end = {}, {}, {}
        section = None
        for i, line in enumerate(self.lines):
            s = line.strip()
            if not s or s.startswith(("#", ";")):
                continue
            if not self.esxml and s.startswith("[") and s.endswith("]"):
                section = s[1:-1]
                self.section_end[section] = i
                continue
            self.section_end[section] = i
            m = self.match(line)
            if m:
                key = f"{section}/{m.group(2)}" if section else m.group(2)
                self.keys.setdefault(key, []).append(i)
                self.section_of[key] = section

    def order(self):
        return list(self.keys)

    def get(self, key):
        idx = self.keys.get(key)
        if not idx:
            return None
        vals = [self.match(self.lines[i]).group(4) for i in idx]
        return vals if len(vals) > 1 else vals[0]

    def _with_value(self, line, value):
        m = self.match(line)
        return m.group(1) + m.group(2) + m.group(3) + value + m.group(5)

    def set(self, key, value):
        idx, vals = self.keys[key], value if isinstance(value, list) else [value]
        for i, v in zip(idx, vals):
            self.lines[i] = self._with_value(self.lines[i], v)
        if len(vals) > len(idx):
            extra = [self._with_value(self.lines[idx[-1]], v) for v in vals[len(idx):]]
            self.lines[idx[-1] + 1:idx[-1] + 1] = extra
        elif len(idx) > len(vals):
            for i in reversed(idx[len(vals):]):
                del self.lines[i]
        self.index()

    def add(self, key, seed):
        new = [seed.lines[i] for i in seed.keys[key]]
        section = seed.section_of.get(key)
        if section is not None and section not in self.section_end:
            while self.lines and not self.lines[-1].strip():
                self.lines.pop()
            self.lines += ["", f"[{section}]"]
            at = len(self.lines)
        else:
            at = self.section_end.get(section, -1) + 1
        self.lines[at:at] = new
        self.index()

    def serialize(self):
        text = "\n".join(self.lines)
        if not text.endswith("\n"):
            text += "\n"
        return text.encode("utf-8", errors="surrogateescape")


class XmlDoc:
    """Cemu's settings.xml: keys are element paths (Graphic/VSync), attributes Input/DSUC@host,
    and a parent whose children all share one leaf tag (GamePaths/Entry) is one list-valued key."""

    def __init__(self, data):
        self.root = ET.fromstring(data)
        self.index()

    def index(self):
        self.items, self.keys = {}, []

        def put(key, item):
            if key not in self.items:
                self.items[key] = item
                self.keys.append(key)

        def walk(elem, path):
            for a in elem.attrib:
                put(f"{path}@{a}", ("attr", elem, a))
            kids = list(elem)
            if not kids:
                if path:
                    put(path, ("leaf", elem, None))
                return
            if len({k.tag for k in kids}) == 1 and all(not list(k) and not k.attrib for k in kids):
                put(path, ("list", elem, kids[0].tag))
                return
            for k in kids:
                walk(k, f"{path}/{k.tag}" if path else k.tag)

        walk(self.root, "")

    def order(self):
        return list(self.keys)

    def get(self, key):
        item = self.items.get(key)
        if item is None:
            return None
        kind, elem, extra = item
        if kind == "leaf":
            return (elem.text or "").strip()
        if kind == "attr":
            return elem.get(extra)
        return [(k.text or "").strip() for k in elem]

    def set(self, key, value):
        kind, elem, extra = self.items[key]
        if kind == "leaf":
            elem.text = value
        elif kind == "attr":
            elem.set(extra, value)
        else:
            for k in list(elem):
                elem.remove(k)
            for v in value:
                ET.SubElement(elem, extra).text = v
        self.index()

    def _ensure(self, path):
        elem = self.root
        for tag in path.split("/"):
            nxt = elem.find(tag)
            if nxt is None:
                nxt = ET.SubElement(elem, tag)
            elem = nxt
        return elem

    def add(self, key, seed):
        kind, _, extra = seed.items[key]
        value = seed.get(key)
        if kind == "attr":
            self._ensure(key.split("@")[0]).set(extra, value)
        elif kind == "leaf":
            self._ensure(key).text = value
        else:
            parent = self._ensure(key)
            for v in value:
                ET.SubElement(parent, extra).text = v
        self.index()

    def serialize(self):
        ET.indent(self.root, space="    ")
        body = ET.tostring(self.root, encoding="unicode")
        return ('<?xml version="1.0" encoding="UTF-8"?>\n' + body + "\n").encode("utf-8")


class JsonDoc:
    """Ryujinx's Config.json: keys are object paths (ui/start_fullscreen), arrays are one
    list-valued key. Values compare as their JSON text so 1, true and "x" stay typed."""

    def __init__(self, data):
        self.root = json.loads(data.decode("utf-8"))
        if not isinstance(self.root, dict):
            raise ValueError("top level is not an object")
        self.index()

    def index(self):
        self.items, self.keys = {}, []

        def walk(obj, path):
            for k, v in obj.items():
                p = f"{path}/{k}" if path else k
                if isinstance(v, dict) and v:
                    walk(v, p)
                else:
                    self.items[p] = (obj, k)
                    self.keys.append(p)

        walk(self.root, "")

    def order(self):
        return list(self.keys)

    def get(self, key):
        item = self.items.get(key)
        if item is None:
            return None
        obj, k = item
        v = obj[k]
        if isinstance(v, list):
            return [json.dumps(x, sort_keys=True) for x in v]
        return json.dumps(v, sort_keys=True)

    def _decode(self, value):
        if isinstance(value, list):
            return [json.loads(x) for x in value]
        return json.loads(value)

    def set(self, key, value):
        obj, k = self.items[key]
        obj[k] = self._decode(value)

    def add(self, key, seed):
        parts = key.split("/")
        obj = self.root
        for p in parts[:-1]:
            nxt = obj.get(p)
            if not isinstance(nxt, dict):
                nxt = obj[p] = {}
            obj = nxt
        obj[parts[-1]] = self._decode(seed.get(key))
        self.index()

    def serialize(self):
        return (json.dumps(self.root, indent=2) + "\n").encode("utf-8")


def parse(fmt, data):
    if fmt == "xml":
        return XmlDoc(data)
    if fmt == "json":
        return JsonDoc(data)
    return LineDoc(data, esxml=(fmt == "esxml"))


class Policy:
    """never = keys we add if absent but never modify; was = the value(s) a key held before we
    seeded it (the app's own default), so a device that still has it counts as untouched even
    though no baseline recorded it."""

    def __init__(self, path):
        self.never_glob, self.never_re, self.was = [], [], {}
        if not path:
            return
        with open(path) as f:
            for raw in f:
                line = raw.split("#", 1)[0].strip()
                if not line:
                    continue
                verb, _, arg = line.partition(" ")
                arg = arg.strip()
                if verb == "never" and arg.startswith("~"):
                    self.never_re.append(re.compile(arg[1:]))
                elif verb == "never":
                    self.never_glob.append(arg)
                elif verb == "was":
                    key, _, val = arg.partition(" ")
                    self.was.setdefault(key, []).append(val.strip())

    def never(self, key):
        return any(fnmatch.fnmatchcase(key, g) for g in self.never_glob) or \
            any(r.search(key) for r in self.never_re)


def same(a, b):
    if isinstance(a, list) != isinstance(b, list):
        a = a if isinstance(a, list) else [a]
        b = b if isinstance(b, list) else [b]
    if isinstance(a, list):
        return [x.strip() for x in a] == [x.strip() for x in b]
    return a.strip() == b.strip()


def class_b(fmt, seed_path, dst, policy_path, mode, fallback=None):
    seed_data = read(seed_path)
    if seed_data is None:
        return
    base_path = baseline_for(dst)
    cur = read(dst)
    if cur is None:
        write(dst, seed_data)
        write(base_path, seed_data)
        log(dst, "seeded")
        return
    try:
        seed, target = parse(fmt, seed_data), parse(fmt, cur)
    except (ET.ParseError, UnicodeDecodeError, ValueError) as e:
        log(dst, f"unparseable ({e}); left alone")
        return
    base_data = read(base_path)
    if base_data is None and fallback:
        base_data = read(fallback)
    base = None
    if base_data is not None:
        try:
            base = parse(fmt, base_data)
        except (ET.ParseError, UnicodeDecodeError, ValueError):
            base = None
    policy = Policy(policy_path)
    added = updated = kept = 0
    for key in seed.order():
        sv, tv = seed.get(key), target.get(key)
        if tv is None:
            target.add(key, seed)
            added += 1
            log(dst, f"add {key}")
            continue
        if same(tv, sv):
            continue
        if mode != "merge" or policy.never(key):
            kept += 1
            if DRY:
                log(dst, f"keep {key} ({'never-touch' if policy.never(key) else 'add-only'})")
            continue
        bv = base.get(key) if base is not None else None
        olds = [bv] if bv is not None else policy.was.get(key, [])
        if any(same(tv, o) for o in olds):
            target.set(key, sv)
            updated += 1
            log(dst, f"set {key}")
        else:
            kept += 1
            if DRY:
                log(dst, f"keep {key} ({'user-changed' if olds else 'no baseline'})")
    if added or updated:
        write(dst, target.serialize(), like=dst)
    write(base_path, seed_data)
    log(dst, f"{added} added, {updated} updated, {kept} kept")


def main():
    global DRY
    ap = argparse.ArgumentParser()
    ap.add_argument("--class", dest="cls", choices=["a", "b"], required=True)
    ap.add_argument("--format", choices=["ini", "racfg", "esxml", "xml", "json"])
    ap.add_argument("--policy")
    ap.add_argument("--mode", choices=["add-only", "merge"], default="add-only")
    ap.add_argument("--dry-run", action="store_true")
    ap.add_argument("--baseline", help="rendered previous seed (or dir), used only when no per-user baseline exists")
    ap.add_argument("src")
    ap.add_argument("dst")
    a = ap.parse_args()
    DRY = a.dry_run
    fb = a.baseline if a.baseline and os.path.exists(a.baseline) else None
    if a.cls == "a":
        class_a(a.src, a.dst, fb)
    else:
        if not a.format:
            ap.error("--class b needs --format")
        class_b(a.format, a.src, a.dst, a.policy, a.mode, fb)


if __name__ == "__main__":
    try:
        main()
    except OSError as e:
        print(f"seed-merge: {e}", file=sys.stderr)
        sys.exit(1)
