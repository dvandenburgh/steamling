# read by steamling-seed-merge; the pad bindings stay three-way on purpose
never Controls/player_0_profile_name
never Controls/player_0_vibration_*
never Controls/player_0_*_color_*
# Eden's own player 1 keyboard bindings. A device where Eden ran before we seeded it has these
# with no baseline to compare against; matching them means nobody changed them, so the pad wins.
was Controls/player_0_button_a "engine:keyboard,code:67,toggle:0"
was Controls/player_0_button_b "engine:keyboard,code:88,toggle:0"
was Controls/player_0_button_x "engine:keyboard,code:86,toggle:0"
was Controls/player_0_button_y "engine:keyboard,code:90,toggle:0"
was Controls/player_0_button_lstick "engine:keyboard,code:70,toggle:0"
was Controls/player_0_button_rstick "engine:keyboard,code:71,toggle:0"
was Controls/player_0_button_l "engine:keyboard,code:81,toggle:0"
was Controls/player_0_button_r "engine:keyboard,code:69,toggle:0"
was Controls/player_0_button_zl "engine:keyboard,code:82,toggle:0"
was Controls/player_0_button_zr "engine:keyboard,code:84,toggle:0"
was Controls/player_0_button_plus "engine:keyboard,code:77,toggle:0"
was Controls/player_0_button_minus "engine:keyboard,code:78,toggle:0"
was Controls/player_0_button_dleft "engine:keyboard,code:16777234,toggle:0"
was Controls/player_0_button_dup "engine:keyboard,code:16777235,toggle:0"
was Controls/player_0_button_dright "engine:keyboard,code:16777236,toggle:0"
was Controls/player_0_button_ddown "engine:keyboard,code:16777237,toggle:0"
was Controls/player_0_button_home "engine:keyboard,code:0,toggle:0"
was Controls/player_0_button_screenshot "engine:keyboard,code:0,toggle:0"
was Controls/player_0_lstick "engine:analog_from_button,up:engine$0keyboard$1code$087$1toggle$00,down:engine$0keyboard$1code$083$1toggle$00,left:engine$0keyboard$1code$065$1toggle$00,right:engine$0keyboard$1code$068$1toggle$00,modifier:engine$0keyboard$1code$016777248$1toggle$00,modifier_scale:0.500000"
was Controls/player_0_rstick "engine:analog_from_button,up:engine$0keyboard$1code$073$1toggle$00,down:engine$0keyboard$1code$075$1toggle$00,left:engine$0keyboard$1code$074$1toggle$00,right:engine$0keyboard$1code$076$1toggle$00,modifier:engine$0keyboard$1code$00$1toggle$00,modifier_scale:0.500000"
