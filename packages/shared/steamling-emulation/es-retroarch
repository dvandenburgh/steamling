#!/bin/bash
# Every RetroArch launch (ES-DE or a steamling-play tile) comes through here. RetroArch saves its
# config on exit and the seeder keeps drifted values as user edits, so one GL fallback would
# stick; --appendconfig re-pins pacing every launch. Values must match retroarch.cfg's pacing
# block and steamling-roms-init's per-panel formula.
# Steam's library path and overlay come along from the shortcut that started ES-DE; RetroArch
# is built against the system libraries (emu-resolve.sh does the same for the other emulators).
unset LD_PRELOAD LD_LIBRARY_PATH
[ -r /usr/lib/steamling/device.conf ] && . /usr/lib/steamling/device.conf
[ -r /etc/steamling/device.conf ] && . /etc/steamling/device.conf
refresh="${STEAMLING_PANEL_REFRESH:-120}"
si=$(( refresh / 60 )); [ "${si}" -lt 1 ] && si=1
# Black frame insertion and shader subframes (the user's call) both need every vblank.
racfg="${HOME}/.config/retroarch/retroarch.cfg"
bfi="$(sed -n 's/^video_black_frame_insertion = "\([0-9]*\)"/\1/p' "${racfg}" 2>/dev/null)"
sub="$(sed -n 's/^video_shader_subframes = "\([0-9]*\)"/\1/p' "${racfg}" 2>/dev/null)"
if [ "${bfi:-0}" -gt 0 ] 2>/dev/null || [ "${sub:-1}" -gt 1 ] 2>/dev/null; then si=1; fi

# GL+vsync under gamescope paces at an irregular ~47fps; audio-paced GL without vsync holds 60.
# glcore, not gl: gl loads only GLSL presets and ours are slang.
driver=vulkan; vsync=true
core=""; prev=""
for a in "$@"; do [ "${prev}" = "-L" ] && core="${a}"; prev="${a}"; done
if [ -n "${core}" ]; then
  name="$(basename "${core}" .so)"; info="/usr/share/libretro/info/${name}.info"
  if grep -q '^required_hw_api' "${info}" 2>/dev/null && ! grep -q '^required_hw_api.*Vulkan' "${info}"; then
    driver=glcore; vsync=false
  fi
  case "${name}" in
    # The info file lists GL only, but ParaLLEl-RDP (the seeded default) renders through Vulkan;
    # only GLideN64 needs the GL context.
    mupen64plus_next_libretro)
      opt="${HOME}/.config/retroarch/config/Mupen64Plus-Next/Mupen64Plus-Next.opt"
      if grep -q '^mupen64plus-rdp-plugin = "gliden64"$' "${opt}" 2>/dev/null; then
        driver=glcore; vsync=false
      else
        driver=vulkan; vsync=true
      fi ;;
    # "OpenGL" here makes RetroArch switch the whole session to GL; only that value is healed
    # ("Auto" follows Vulkan, "Software" is deliberate).
    swanstation_libretro)
      opt="${HOME}/.config/retroarch/config/SwanStation/SwanStation.opt"
      [ -w "${opt}" ] && sed -i 's/^swanstation_GPU_Renderer = "OpenGL"$/swanstation_GPU_Renderer = "Vulkan"/' "${opt}" ;;
  esac
fi

frag="${XDG_RUNTIME_DIR:-/tmp}/steamling-retroarch-pacing.cfg"
cat > "${frag}" <<CFG
video_driver = "${driver}"
video_vsync = "${vsync}"
video_refresh_rate = "${refresh}.000000"
video_swap_interval = "${si}"
video_max_swapchain_images = "2"
CFG
# Without vsync, BFI and subframes have no vblank to hang on and flicker or halve speed; off for
# this launch only.
if [ "${vsync}" = false ]; then
  printf 'video_black_frame_insertion = "0"\nvideo_shader_subframes = "1"\n' >> "${frag}"
fi

exec retroarch -f --appendconfig "${frag}" "$@"
