# read by steamling-seed-merge (verbs documented there)
never input_config
never version
never audio_volume
never hotkeys/*
never gui_columns/*
never column_sort/*
never window_startup/*
never language_code
never base_style
never system_language
never system_region
never system_time_zone
never system_time_offset
never preferred_gpu
never multiplayer_*
never game_list_view_mode
never show_names
never grid_size
never application_sort
never is_ascending_order
never enable_file_log
never logging_*
