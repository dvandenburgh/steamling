#!/bin/bash
# A loop, not an exec: this stays the logind session leader across switches. A fresh session
# per switch leaves kwin without DRM master.

# No login shell runs here; profile.d still has to (locale, flatpak XDG_DATA_DIRS).
[ -r /etc/profile ] && . /etc/profile

# "plasma" means desktop mode, whichever desktop steamling-desktop-select picks: it is the word
# Steam passes to steamos-session-select.
STATE="${XDG_STATE_HOME:-${HOME}/.local/state}/steamling-session"
PIDFILE="${XDG_RUNTIME_DIR:-/run/user/$(id -u)}/steamling-desktop.pid"
SWITCH="${XDG_RUNTIME_DIR:-/run/user/$(id -u)}/steamling-session.switch"
LOG="${HOME}/steamling-session.log"

if [ -e "${HOME}/.no-steam" ]; then
  echo "steamling-session: ~/.no-steam present, leaving tty1 to a login prompt" >&2
  exit 3
fi

# tty1 shows between compositors.
blank() { printf '\033[?25l\033[2J\033[H' >/dev/tty 2>/dev/null; }

# The whole login session is our cgroup, including what got re-parented to PID 1 when its
# parent died (gamescope's reaper, Xwayland), which a walk of our children would miss.
SCOPE="/sys/fs/cgroup$(sed -n 's/^0:://p' /proc/self/cgroup)/cgroup.procs"

# run() ticks every second for as long as a session lives. A pipe this shell holds both ends
# of never reaches EOF, so a timed read on it sleeps without forking /usr/bin/sleep each tick;
# if it cannot be opened, /dev/null ends every read at once and sleep does the waiting.
{ exec {TICK}<> <(:); } 2>/dev/null || exec {TICK}</dev/null
tick() { read -r -t "$1" -u "${TICK}" && return; [ $? -gt 128 ] || sleep "$1"; }

# Builtins only, so no helper of ours shows up. (sd-pam) holds the PAM session: killing it
# would end the logind session.
leftovers() {
  local p c
  while read -r p; do
    [ "${p}" = "$$" ] || [ "${p}" = "${BASHPID}" ] && continue
    read -r c < "/proc/${p}/comm" 2>/dev/null
    [ "${c}" = "(sd-pam)" ] || echo "${p}"
  done < "${SCOPE}"
}

sweep() {  # <TERM|KILL>; TERM escalates to KILL after 3s
  local pids t
  mapfile -t pids < <(leftovers)
  [ "${#pids[@]}" -gt 0 ] || return 0
  echo "steamling-session: ${1} to what the last session left: ${pids[*]}" >&2
  kill -"$1" "${pids[@]}" 2>/dev/null
  [ "$1" = TERM ] || return 0
  for t in 1 2 3; do
    tick 1
    mapfile -t pids < <(leftovers)
    [ "${#pids[@]}" -gt 0 ] || return 0
  done
  kill -KILL "${pids[@]}" 2>/dev/null
}

# A switch only TERMs the compositor, and one TERM-proof straggler (a Wine process stuck in
# ntsync) holds gamescope's reaper, and so the launcher, open forever (#107). Anything still
# running 6s after a switch request, or left once the launcher is gone, is killed from here.
run() {  # <launcher>
  local child t=0
  # The last session's log survives one more as .prev: a desktop that came up black and was
  # restarted out of is otherwise wiped by the game mode session that follows.
  [ -s "${LOG}" ] && mv -f "${LOG}" "${LOG}.prev"
  # Append mode for both writers: a truncating fd would overwrite lines written meanwhile.
  : >"${LOG}"
  "$1" >>"${LOG}" 2>&1 {TICK}<&- &
  child=$!
  while kill -0 "${child}" 2>/dev/null; do
    tick 1
    [ -e "${SWITCH}" ] || continue
    t=$(( t + 1 ))
    [ "${t}" -ge 6 ] && { sweep KILL; break; }
  done
  wait "${child}" 2>/dev/null
  sweep TERM
}

# Plasma 6 runs kwin as a user service, outside our scope, and it outlives its launcher by
# seconds: the next compositor would start without DRM master and modeset into a black panel.
# kwin is PartOf graphical-session.target, but stopping the target only queues kwin's stop.
release_display() {
  local holder i
  timeout 15 systemctl --user stop graphical-session.target \
    || echo "steamling-session: stopping graphical-session.target failed (rc $?)" >&2
  for i in $(seq 1 50); do
    # kwin's file caps make its fds root-owned, invisible to the card scan: for a service
    # compositor the user manager's pending jobs and deactivating units are the signal.
    holder="$(systemctl --user list-jobs --no-legend --plain 2>/dev/null | head -1)"
    [ -n "${holder}" ] || holder="$(systemctl --user list-units --state=deactivating \
      --no-legend --plain 2>/dev/null | head -1)"
    [ -n "${holder}" ] || holder="$(find /proc/[0-9]*/fd -lname '/dev/dri/card*' -print -quit 2>/dev/null)"
    if [ -z "${holder}" ]; then
      [ "${i}" -gt 1 ] && echo "steamling-session: display released after $(( (i - 1) * 200 ))ms" >&2
      return 0
    fi
    sleep 0.2
  done
  echo "steamling-session: ${holder} still holds the display after 10s, starting anyway" >&2
}

fastfails=0
first=1
while true; do
  session="$(cat "${STATE}" 2>/dev/null || echo gamescope)"
  rm -f "${SWITCH}"
  blank
  # Before the clock starts: time spent waiting here is no evidence the session works.
  # Not on the first pass with no compositor of ours alive, which is every boot: nothing can be
  # holding the display then, and release_display would wait out the user manager's own startup
  # jobs instead (PipeWire's sockets and the rest), about a second and a half of black screen
  # measured on an RP6. A restart of this unit after a crash still finds kwin and waits.
  if [ "${first}" = 1 ] && ! pgrep -u "$(id -u)" -x 'kwin_wayland|kwin_wayland_wr|gamescope-wl' >/dev/null 2>&1; then
    :
  else
    release_display
  fi
  first=0
  start="$(date +%s)"
  case "${session}" in
    plasma|desktop) command -v steamling-desktop >/dev/null 2>&1 && run steamling-desktop
                    rm -f "${PIDFILE}" ;;  # a recycled PID must never be signalled as the session
    *)              command -v steamling-steam   >/dev/null 2>&1 && run steamling-steam ;;
  esac
  # Under 5s is a broken session, not a switch.
  if [ "$(( $(date +%s) - start ))" -lt 5 ]; then
    fastfails=$(( fastfails + 1 ))
    # Desktop mode can be gone or broken (the desktop layer is removable) while Steam still
    # offers it; game mode is the screen that always has a way back.
    if [ "${fastfails}" -ge 3 ] && [ "${session}" != gamescope ]; then
      echo "steamling-session: desktop mode keeps exiting immediately, back to game mode" >&2
      printf 'gamescope\n' > "${STATE}"
      fastfails=0
    elif [ "${fastfails}" -ge 3 ]; then
      printf '\033[?25h' >/dev/tty 2>/dev/null
      echo "steamling-session: '${session}' keeps exiting immediately, see ${LOG}" >&2
      exit 3
    fi
  else
    fastfails=0
  fi
done
