# steamling-steam — native ARM64 Steam (Big Picture under gamescope): the client installer, the
# gamescope launcher, and the ARM-Proton compat-tool plumbing.
pkgname=steamling-steam
pkgver=0.1.1
pkgrel=1.5
pkgdesc="Native ARM64 Steam Big Picture (gamescope) for the RP6 — installer + launcher"
arch=('any')
url="https://github.com/dvandenburgh/steamling"
license=('GPL-2.0-or-later')
# wget/unzip/curl/tar/xorg-server-xvfb serve steamling-steam-install, which runs in the image bake
# and again at first launch if the client is missing, so they stay depends. The rest are dlopen
# deps the ARM client needs and nothing on a from-scratch ALARM base pulls in.
# ffmpeg (ffplay) + xorg-xprop: steamling-steam-splash. python: steamling-powerbuttond.
# Depends on steamling-steam-full (a cycle pacman accepts): devices fielded before the metas
# have this package but not the meta, and -Syu only installs a new name something requires.
# Build with ./nodeps so makepkg -s does not drag the layer into the chroot.
depends=('steamling-steam-full' 'steamling-bsp-common>=0.1.0-24'
         'gamescope' 'wget' 'unzip' 'curl' 'tar' 'gtk2' 'gdk-pixbuf2' 'openal' 'libcups' 'lsof'
         'noto-fonts' 'noto-fonts-cjk' 'noto-fonts-emoji' 'networkmanager' 'mangohud'
         'steamling-steamos-shim' 'xorg-server-xvfb' 'ffmpeg' 'xorg-xprop' 'python')
install=steamling-steam.install
source=('steamling-steam-install' 'steamling-steam' 'steamling-steam-splash' 'steamling-steam-sync' 'steam' 'steam.desktop'
        'steam-256.png' 'steam-512.png'
        'steamling-proton-prep' 'steamling-proton-prep.service'
        'steamling-game-launch' 'steamling-steam-env' 'steamling-steam-channel' 'steamling-proton-wrapper' 'fex-profiles.json'
        'steamling-guestos-mount' 'steamling-guestos.service' 'graphics_provider.json'
        'steamling-powerbuttond'
        'steamling-fex-binfmt' 'steamling-fex-binfmt.service' '90-steamling-fex-binfmt.hook'
        'steamling-oobe-marker' 'steamling-oobe-marker.service')
sha256sums=('SKIP' 'SKIP' 'SKIP' 'SKIP' 'SKIP' 'SKIP' 'SKIP' 'SKIP' 'SKIP' 'SKIP' 'SKIP' 'SKIP'
            'SKIP' 'SKIP' 'SKIP' 'SKIP' 'SKIP' 'SKIP' 'SKIP' 'SKIP' 'SKIP' 'SKIP' 'SKIP' 'SKIP')

package() {
  install -Dm755 "${srcdir}/steamling-steam-install" "${pkgdir}/usr/bin/steamling-steam-install"
  install -Dm755 "${srcdir}/steamling-steam"         "${pkgdir}/usr/bin/steamling-steam"
  install -Dm755 "${srcdir}/steamling-steam-splash"  "${pkgdir}/usr/lib/steamling/steamling-steam-splash"
  # lives here, not in steamling-emulation: it must still run (and prune) after the layer is removed
  install -Dm755 "${srcdir}/steamling-steam-sync"    "${pkgdir}/usr/bin/steamling-steam-sync"
  install -Dm755 "${srcdir}/steam"                 "${pkgdir}/usr/bin/steam"
  install -Dm644 "${srcdir}/steam.desktop"         "${pkgdir}/usr/share/applications/steam.desktop"
  # The native ARM client is not a system package, so nothing else provides the themed `steam`
  # icon that steam.desktop references.
  install -Dm644 "${srcdir}/steam-256.png"         "${pkgdir}/usr/share/icons/hicolor/256x256/apps/steam.png"
  install -Dm644 "${srcdir}/steam-512.png"         "${pkgdir}/usr/share/icons/hicolor/512x512/apps/steam.png"
  install -Dm755 "${srcdir}/steamling-proton-prep"           "${pkgdir}/usr/bin/steamling-proton-prep"
  install -Dm644 "${srcdir}/steamling-proton-prep.service"   "${pkgdir}/usr/lib/systemd/user/steamling-proton-prep.service"
  # Named bare in every game's launch options (Governor), so it must stay on PATH under
  # this name: never move or rename it.
  install -Dm755 "${srcdir}/steamling-game-launch"           "${pkgdir}/usr/bin/steamling-game-launch"
  install -Dm644 "${srcdir}/steamling-steam-env"             "${pkgdir}/usr/lib/steamling/steamling-steam-env"
  install -Dm755 "${srcdir}/steamling-steam-channel"         "${pkgdir}/usr/lib/steamling/steamling-steam-channel"
  install -Dm755 "${srcdir}/steamling-proton-wrapper"        "${pkgdir}/usr/lib/steamling/steamling-proton-wrapper"
  install -Dm644 "${srcdir}/fex-profiles.json"             "${pkgdir}/usr/share/steamling/fex-profiles.json"
  install -Dm755 "${srcdir}/steamling-guestos-mount"         "${pkgdir}/usr/lib/steamling/steamling-guestos-mount"
  install -Dm644 "${srcdir}/steamling-guestos.service"       "${pkgdir}/usr/lib/systemd/system/steamling-guestos.service"
  install -Dm644 "${srcdir}/graphics_provider.json"        "${pkgdir}/usr/share/steamling-steam/graphics_provider.json"
  install -Dm755 "${srcdir}/steamling-powerbuttond"          "${pkgdir}/usr/lib/steamling/steamling-powerbuttond"
  # FEX's x86 binfmt switch: the boot unit and the pacman hook both re-assert the persisted choice.
  install -Dm755 "${srcdir}/steamling-fex-binfmt"            "${pkgdir}/usr/bin/steamling-fex-binfmt"
  install -Dm644 "${srcdir}/steamling-fex-binfmt.service"    "${pkgdir}/usr/lib/systemd/system/steamling-fex-binfmt.service"
  install -d "${pkgdir}/usr/lib/systemd/system/multi-user.target.wants"
  ln -sf "../steamling-fex-binfmt.service" \
    "${pkgdir}/usr/lib/systemd/system/multi-user.target.wants/steamling-fex-binfmt.service"
  install -Dm644 "${srcdir}/90-steamling-fex-binfmt.hook"    "${pkgdir}/usr/share/libalpm/hooks/90-steamling-fex-binfmt.hook"
  # Steam's first-run setup marker: the SD image creates it, this unit retires it once setup is done.
  install -Dm755 "${srcdir}/steamling-oobe-marker"           "${pkgdir}/usr/lib/steamling/steamling-oobe-marker"
  install -Dm644 "${srcdir}/steamling-oobe-marker.service"   "${pkgdir}/usr/lib/systemd/system/steamling-oobe-marker.service"
  ln -sf "../steamling-oobe-marker.service" \
    "${pkgdir}/usr/lib/systemd/system/multi-user.target.wants/steamling-oobe-marker.service"
}
