# steamling-snapshots — pre-update btrfs snapshots plus a rollback that needs no boot
# menu: two alpm hooks wrap every pacman transaction, and steamling-rollback switches the
# fs default subvolume. Every entry point no-ops when / is not btrfs (build chroot,
# pre-snapshot ext4 installs).
pkgname=steamling-snapshots
pkgver=0.1.1
pkgrel=1
pkgdesc="steamling pre-update btrfs snapshots and rollback (subvolume set-default)"
arch=('any')
url="https://github.com/dvandenburgh/steamling"
license=('GPL-2.0-or-later')
depends=('btrfs-progs' 'jq' 'util-linux')
backup=('etc/steamling/snapshots.conf')
source=('05-steamling-snapshot.hook' '99-steamling-snapshot-post.hook'
        'snapshot-lib.sh'
        'steamling-snapshot-pre' 'steamling-snapshot-post'
        'steamling-snapshots' 'steamling-rollback'
        'steamling-rollback-repair' 'steamling-rollback-repair.service'
        'snapshots.conf' '50-steamling-snapshots.rules')
sha256sums=('SKIP' 'SKIP' 'SKIP' 'SKIP' 'SKIP' 'SKIP' 'SKIP' 'SKIP' 'SKIP' 'SKIP' 'SKIP')

package() {
  install -Dm644 "${srcdir}/05-steamling-snapshot.hook" \
    "${pkgdir}/usr/share/libalpm/hooks/05-steamling-snapshot.hook"
  install -Dm644 "${srcdir}/99-steamling-snapshot-post.hook" \
    "${pkgdir}/usr/share/libalpm/hooks/99-steamling-snapshot-post.hook"

  install -Dm644 "${srcdir}/snapshot-lib.sh" "${pkgdir}/usr/lib/steamling/snapshot-lib.sh"

  local bin
  for bin in steamling-snapshot-pre steamling-snapshot-post steamling-snapshots \
             steamling-rollback steamling-rollback-repair; do
    install -Dm755 "${srcdir}/${bin}" "${pkgdir}/usr/bin/${bin}"
  done

  install -Dm644 "${srcdir}/snapshots.conf" "${pkgdir}/etc/steamling/snapshots.conf"

  install -Dm644 "${srcdir}/50-steamling-snapshots.rules" \
    "${pkgdir}/usr/share/polkit-1/rules.d/50-steamling-snapshots.rules"

  # statically enabled via a wants symlink; ConditionPathExists keeps it inert
  # except on a rolled-back boot
  install -Dm644 "${srcdir}/steamling-rollback-repair.service" \
    "${pkgdir}/usr/lib/systemd/system/steamling-rollback-repair.service"
  install -d "${pkgdir}/usr/lib/systemd/system/multi-user.target.wants"
  ln -s ../steamling-rollback-repair.service \
    "${pkgdir}/usr/lib/systemd/system/multi-user.target.wants/steamling-rollback-repair.service"
}
