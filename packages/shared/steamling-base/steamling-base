#!/usr/bin/env bash
# steamling-base — show or switch the device's package base (locked snapshot vs live ALARM).
# rolling appends the live repos BELOW [steamling] so steamling packages keep winning name
# resolution, and -Syu's in the same breath: never leave the half-frozen partial-upgrade
# state the lock exists to prevent. The rolling-mode flag is admin intent — it is what
# stops steamling-lock-migrate auto-relocking the device.

set -euo pipefail

CONF=/etc/pacman.conf
FLAG=/etc/steamling/rolling-mode
MIGRATE=/usr/lib/steamling/steamling-lock-migrate
PENDING=/var/lib/steamling/lock-migrate-pending
BLOCKED=/var/lib/steamling/lock-converge-blocked

die() { printf 'steamling-base: %s\n' "$*" >&2; exit 1; }

# the base section's name: ours, or the borrowed [pocknix-base]
base_repo() { sed -n 's/^\[\(steamling-base\|pocknix-base\)\]$/\1/p' "${CONF}" | head -1; }

mode() {
  if [ -n "$(base_repo)" ]; then echo locked
  elif grep -q '^\[core\]' "${CONF}"; then echo rolling
  else echo unknown; fi
}

# Steamling's own package repos, [steamling] and [steamling-shared], at the address the build
# stamped into repo-url, signed with the key next to it. $1: "auto" (the install scriptlet) adds
# them only to a device that has neither, and quietly does nothing it can't; "replace" (sudo
# steamling-base repo) swaps out whatever [steamling] sections there are, like the LAN ones
# docs/updating.md has you add, and says why when it can't.
repo_sections() {
  local how="$1" url="" key=/usr/share/steamling/steamling-repo.gpg soc fpr anchor
  read -r url < /usr/share/steamling/repo-url 2>/dev/null || true
  if [ -z "${url}" ] || [ ! -s "${key}" ]; then
    [ "${how}" = auto ] && return 0
    die "this build has no package repo (no address or key in /usr/share/steamling)"
  fi
  if [ "${how}" = auto ] && grep -q '^\[steamling\]$' "${CONF}"; then return 0; fi
  soc="$(ls -d /var/lib/pacman/local/linux-steamling-sm*-[0-9]* 2>/dev/null | head -1 \
         | sed -n 's|.*/linux-steamling-\(sm[0-9]*\)-.*|\1|p')"
  [ -n "${soc}" ] || { [ "${how}" = auto ] && return 0; die "can't tell this handheld's chip family from its kernel package"; }
  fpr="$(gpg --show-keys --with-colons "${key}" 2>/dev/null | awk -F: '/^fpr/{print $10; exit}')"
  [ -n "${fpr}" ] || { [ "${how}" = auto ] && return 0; die "can't read the repo key's fingerprint"; }
  if ! { pacman-key --add "${key}" >/dev/null 2>&1 && pacman-key --lsign-key "${fpr}" >/dev/null 2>&1; }; then
    echo "steamling: couldn't trust the package repo key; the repo isn't added yet."
    [ "${how}" = auto ] && return 0; exit 1
  fi
  # drop any [steamling]/[steamling-shared] sections (each ends at the next section header)
  awk 'BEGIN{drop=0} /^\[/{drop = ($0=="[steamling]" || $0=="[steamling-shared]")} !drop' "${CONF}" \
    > "${CONF}.steamling-repo" && cat "${CONF}.steamling-repo" > "${CONF}"
  # above the base, as an image has them: ours must outrank Arch's same-named packages
  for anchor in '[steamling-base]' '[pocknix-base]' '[core]'; do grep -qxF "${anchor}" "${CONF}" && break; anchor=""; done
  [ -n "${anchor}" ] || { rm -f "${CONF}.steamling-repo"; [ "${how}" = auto ] && return 0; die "no base section in ${CONF} to put the repos above"; }
  awk -v a="${anchor}" -v u="${url%/}" -v s="${soc}" '
    $0 == a && !done { print "[steamling]"; print "SigLevel = Required DatabaseOptional"; print "Server = " u "/" s; print ""
                       print "[steamling-shared]"; print "SigLevel = Required DatabaseOptional"; print "Server = " u "/shared"; print ""
                       done = 1 }
    { print }' "${CONF}" > "${CONF}.steamling-repo" && cat "${CONF}.steamling-repo" > "${CONF}"
  rm -f "${CONF}.steamling-repo"
  echo "steamling: updates now come from Steamling's package repos (${url%/}/${soc} and /shared)."
}

# the snapshot id IS the steamling-base-lock pkgver (the stable repo url carries none)
snapshot_id() { pacman -Q steamling-base-lock 2>/dev/null | awk '{print $2}' | cut -d- -f1; }

# Installed but in neither locked repo. Guard: on an unsynced device (fresh image,
# no dbs) an empty repo list would make every installed package look foreign.
foreign() {
  local repo
  repo="$(pacman -Slq steamling steamling-shared $(base_repo) 2>/dev/null | LC_ALL=C sort -u)"
  [ -n "${repo}" ] || return 0
  LC_ALL=C comm -23 <(pacman -Qq | LC_ALL=C sort) <(printf '%s\n' "${repo}")
}

status() {
  local m n
  m="$(mode)"
  case "${m}" in
    locked)  echo "mode          : LOCKED (supported)"
             echo "base snapshot : $(snapshot_id || true)" ;;
    rolling) echo "mode          : ROLLING (bleeding edge, unsupported)"
             echo "                'sudo steamling-base locked' returns to the supported base" ;;
    unknown) echo "mode          : UNKNOWN (neither a base section nor [core] in ${CONF})" ;;
  esac
  echo "repos         : $(grep -o '^\[[^]]*\]' "${CONF}" | tr -d '[]' | grep -v '^options$' | paste -sd' ' -)"
  if [ -f "${BLOCKED}" ]; then
    echo "base update   : BLOCKED by $(paste -sd' ' "${BLOCKED}")"
    echo "                remove it (pacman -Rs <name>) then: steamling-base locked"
  elif [ -f "${PENDING}" ]; then
    echo "base update   : pending (runs on the next connect; systemctl start steamling-lock-converge)"
  fi
  n="$(foreign | grep -c . || true)"
  if [ "${m}" = locked ] && [ "${n}" != 0 ]; then
    echo "not from steamling (${n}): $(foreign | paste -sd' ' -)"
    echo "                these keep working but do not update on a locked device"
  fi
}

case "${1:-status}" in
  status) status ;;

  rolling)
    [ "$(id -u)" -eq 0 ] || die "must run as root (sudo steamling-base rolling)"
    [ "$(mode)" = locked ] || die "device is not in locked mode (current: $(mode))"
    cat <<'EOF'

  BLEEDING-EDGE MODE tracks live Arch Linux ARM.

  Steamling's own stack (gamescope, mesa, the Steam session) is built against
  the FROZEN base. Once rolling, any ALARM update can break it without
  warning until the next steamling release — up to and including a black
  screen on boot.

  This mode is UNSUPPORTED: bugs must be reproduced on a locked device.

  Seatbelts that remain: every update is still btrfs-snapshot-wrapped
  (steamling-rollback undoes the last one), and 'sudo steamling-base locked'
  returns fully to the supported state at any time.

EOF
    read -rp "  Type ROLL to continue: " a
    [ "${a}" = "ROLL" ] || { echo "cancelled."; exit 0; }
    # No [steamling] repo: nothing outranks ALARM, so the -Syu below would swap our gamescope and
    # mesa for theirs. Hold everything the locked base doesn't carry (ours, and whatever else was
    # added by hand); listed now, while the base is still the only repo it's measured against.
    held=""
    grep -q '^\[steamling\]' "${CONF}" || held="$(pacman -Qqm | tr '\n' ' ')"
    # the next section header (or the end of the file) ends the base section
    awk 'BEGIN{drop=0} /^\[/{drop = ($0=="[steamling-base]" || $0=="[pocknix-base]")} !drop' "${CONF}" \
      > "${CONF}.steamling-rolling" && cat "${CONF}.steamling-rolling" > "${CONF}"
    rm -f "${CONF}.steamling-rolling"
    if [ -n "${held// /}" ]; then
      sed -i "/^\[options\]$/a # steamling-base rolling: no [steamling] repo, so these stay as built\nIgnorePkg   = ${held% }" "${CONF}"
      echo "  holding Steamling's own packages (no [steamling] repo): ${held% }"
    fi
    cat >> "${CONF}" <<'EOF'

# BLEEDING-EDGE: live Arch Linux ARM (steamling-base rolling). [steamling] stays
# first so steamling's own packages keep winning name resolution.
[core]
Include = /etc/pacman.d/mirrorlist
[extra]
Include = /etc/pacman.d/mirrorlist
[alarm]
Include = /etc/pacman.d/mirrorlist
[aur]
Include = /etc/pacman.d/mirrorlist
EOF
    install -d /etc/steamling
    echo "bleeding-edge rolling mode, chosen $(date -u +%F). 'steamling-base locked' returns." > "${FLAG}"
    echo
    echo "==> switching to a coherent rolling state (full pacman -Syu)..."
    pacman -Syu --noconfirm
    echo
    echo "Device is now ROLLING. steamling-rollback undoes the last update;"
    echo "'sudo steamling-base locked' returns to the supported locked base."
    ;;

  locked)
    [ "$(id -u)" -eq 0 ] || die "must run as root (sudo steamling-base locked)"
    [ -x "${MIGRATE}" ] || die "${MIGRATE} missing (steamling-lock-migrate not installed?)"
    # A converge refused by a blocking package leaves the device locked with the migration
    # still armed, so "remove it, re-run" must resume here, not fail the rolling-mode check.
    if [ "$(mode)" = locked ] && [ -f "${PENDING}" ]; then
      echo "The base update is still pending on this device; resuming the converge."
      echo
      "${MIGRATE}" converge
      exit 0
    fi
    [ "$(mode)" = rolling ] || die "device is not in rolling mode (current: $(mode))"
    echo "Returning to the locked base: every base package converges (down) to the"
    echo "snapshot. Software installed while rolling may block this if it pins newer"
    echo "libraries — the converge names it and this command can be re-run after"
    echo "removing it. Anything that survives but was built against newer libraries"
    echo "may need removal too (the btrfs snapshot from unlock still covers a full"
    echo "steamling-rollback)."
    echo
    rm -f "${FLAG}"
    "${MIGRATE}" prepare
    "${MIGRATE}" converge
    ;;

  repo)
    [ "$(id -u)" -eq 0 ] || die "must run as root (sudo steamling-base repo)"
    # the scriptlet's mode; by hand it always replaces what's there
    if [ "${2:-}" = --auto ]; then repo_sections auto; else repo_sections replace; fi
    ;;

  *) die "usage: steamling-base [status|rolling|locked|repo]" ;;
esac
