#!/bin/bash
# Stamps Steamling identity into /usr/lib/os-release (filesystem-owned, so the hook re-runs
# this after every filesystem upgrade, and steamling-os-release.service at every boot for the
# device name). Steam's Settings > System reads VERSION_ID as "OS Version", BUILD_ID as
# "OS Build", VERSION_CODENAME as "OS Codename" and VARIANT_ID as "OS Variant". ID/ID_LIKE stay archarm/arch for tooling.
set -euo pipefail

# Bump at each image cut. Each release also gets a codename, lowercase and one word: Steam shows
# it as is under OS Codename.
STEAMLING_VERSION=0.1.1
STEAMLING_CODENAME=hatchling

osr=/usr/lib/os-release
lock=/usr/share/steamling/steamling-base.lock
[ -f "${osr}" ] || exit 0

# The kernel package names the SoC family; the device tree would be the build host's in
# an image chroot.
soc="$(ls -d /var/lib/pacman/local/linux-steamling-sm*-[0-9]* 2>/dev/null | head -1 | sed -n 's|.*/linux-steamling-\(sm[0-9]*\)-.*|\1|p' || true)"
base="$(sed -n 's/^#.*snapshot \([0-9][0-9.]*\).*/\1/p' "${lock}" 2>/dev/null | head -1 || true)"
# The handheld's own name, from its devicetree ("Retroid Pocket 6"). Never inside a chroot,
# where it would be the build host's. VARIANT_ID is meant to be a lowercase id, but it is the
# field Steam shows, so it carries the readable name; nothing else reads it.
model=""
if [ -r /sys/firmware/devicetree/base/model ] && ! systemd-detect-virt --quiet --chroot 2>/dev/null; then
  model="$(tr -d '\000"\\$`' < /sys/firmware/devicetree/base/model)"
fi

tmp="$(mktemp "${osr}.XXXXXX")"
trap 'rm -f "${tmp}"' EXIT
{
  echo 'NAME="Steamling OS"'
  echo 'PRETTY_NAME="Steamling OS"'
  echo "VERSION=\"${STEAMLING_VERSION}${base:+ (base ${base})}\""
  echo "VERSION_ID=${STEAMLING_VERSION}"
  echo "VERSION_CODENAME=${STEAMLING_CODENAME}"
  echo "BUILD_ID=${base:-rolling}"
  if [ -n "${model}" ]; then
    echo "VARIANT=\"${model}\""
    echo "VARIANT_ID=\"${model}${soc:+ (${soc^^})}\""
  elif [ -n "${soc}" ]; then
    echo "VARIANT_ID=${soc}"
  fi
  echo 'HOME_URL="https://github.com/dvandenburgh/steamling"'
  echo 'BUG_REPORT_URL="https://github.com/dvandenburgh/steamling/issues"'
  grep -vE '^(NAME|PRETTY_NAME|VERSION|VERSION_ID|VERSION_CODENAME|BUILD_ID|VARIANT|VARIANT_ID|HOME_URL|DOCUMENTATION_URL|SUPPORT_URL|BUG_REPORT_URL)=' "${osr}" || true
} > "${tmp}"
# Runs every boot: leave the file alone when nothing changed.
cmp -s "${tmp}" "${osr}" && exit 0
chmod 644 "${tmp}"
mv -f "${tmp}" "${osr}"
