# libretro-cores-steamling — a curated aarch64 libretro core set, vendored prebuilt from
# christianhaitian/retroarch-cores (the ArkOS/TheRA set).
# Vendored because RetroArch's in-app Core Updater serves no arm64 cores: a core absent at
# image time cannot be fetched on device. They install to /usr/lib/libretro, the same path
# ALARM's libretro-* packages use, so a vendored core can be replaced transparently.
pkgbase=libretro-cores-steamling
# The NES, SNES, Game Boy and GBA cores ship as their own packages, so the source-built ones
# (packages/soc/libretro-*-steamling, ./build.sh --cores) can replace just those.
_split=(fceumm snes9x gambatte mgba)
pkgname=(libretro-cores-steamling "${_split[@]/#/libretro-cores-steamling-}")
pkgver=0.1.1
pkgrel=2
pkgdesc="Curated prebuilt aarch64 libretro cores for the RP6 (vendored, ArkOS/TheRA set)"
arch=('aarch64')
url="https://github.com/christianhaitian/retroarch-cores"
license=('GPL2')  # umbrella only; per-core licenses vary, some arcade cores non-commercial
depends=()
makedepends=('unzip')

# Pinned: upstream force-updates the files in place, so a floating ref is not reproducible.
_commit=913e84e8371aa252e1c520729fba04bb6a8bc1f1
_base="https://raw.githubusercontent.com/christianhaitian/retroarch-cores/${_commit}/aarch64"

# N64 (mupen64plus_next), Dreamcast (flycast) and PlayStation (swanstation, replacing
# duckstation) are built from source in packages/soc/libretro-*, with Vulkan.
_cores=(
  fceumm nestopia snes9x gambatte mgba melonds
  genesis_plus_gx picodrive yabasanshiro
  pcsx_rearmed ppsspp
  mednafen_pce_fast mednafen_supergrafx fbneo mame2003_plus
  stella prosystem handy virtualjaguar
  mednafen_wswan mednafen_ngp mednafen_vb
)

source=()
sha256sums=()
for _c in "${_cores[@]}"; do
  source+=("${_c}_libretro.so.zip::${_base}/${_c}_libretro.so.zip")
  sha256sums+=('SKIP')
done

_install_core() {  # $1 = core
  install -dm755 "${pkgdir}/usr/lib/libretro"
  unzip -o "${srcdir}/${1}_libretro.so.zip" -d "${pkgdir}/usr/lib/libretro/" >/dev/null
  chmod 644 "${pkgdir}/usr/lib/libretro/${1}_libretro.so"
}

package_libretro-cores-steamling() {
  # Each split core is asked for by what it provides, so a source-built one satisfies it too.
  depends=("${_split[@]/#/steamling-libretro-}")
  local c
  for c in "${_cores[@]}"; do
    case " ${_split[*]} " in *" ${c} "*) continue ;; esac
    _install_core "${c}"
  done
}

_split_package() {  # $1 = core
  pkgdesc="Prebuilt aarch64 ${1} libretro core (vendored, ArkOS/TheRA set)"
  provides=("steamling-libretro-${1}")
  conflicts=("steamling-libretro-${1}")
  _install_core "${1}"
}
package_libretro-cores-steamling-fceumm()   { _split_package fceumm; }
package_libretro-cores-steamling-snes9x()   { _split_package snes9x; }
package_libretro-cores-steamling-gambatte() { _split_package gambatte; }
package_libretro-cores-steamling-mgba()     { _split_package mgba; }
