#!/usr/bin/env bash
# steamling-lock-migrate — convert a rolling device to the locked base in place; also the
# engine behind `steamling-base locked`. Two phases because pacman.conf cannot be swapped
# inside the transaction resolving against it: prepare rewrites the repos and arms a marker
# from post_install; converge runs -Syuu later, downgrades allowed since a rolling device
# may be AHEAD of the snapshot.

set -euo pipefail

CONF=/etc/pacman.conf
STATE=/var/lib/steamling
MARKER="${STATE}/lock-migrate-pending"
BLOCKED="${STATE}/lock-converge-blocked"
FOREIGN="${STATE}/foreign-packages"
# stamped by the PKGBUILD from the build's pin
BASE_URL="@STEAMLING_BASE_URL@"
BASE_REPO="@STEAMLING_BASE_REPO@"
BASE_PARTS="@STEAMLING_BASE_PARTS@"

# The base section exactly as lib.sh render_base_pacman_conf writes it into an image.
stanza() {
  local i
  printf '[%s]\nSigLevel = Required DatabaseOptional\n' "${BASE_REPO}"
  for ((i = 2; i <= BASE_PARTS; i++)); do printf 'CacheServer = %s-%d\n' "${BASE_URL}" "${i}"; done
  printf 'Server = %s\n' "${BASE_URL}"
}
# What the device has now: every base section (ours, or the borrowed [pocknix-base]), blank lines left out.
current_stanza() {
  awk '/^\[/{on = ($0=="[steamling-base]" || $0=="[pocknix-base]")} on && NF' "${CONF}"
}
# Rewrite the conf without the sections named (the next section header ends each one).
drop_sections() {
  awk -v names=" $* " 'BEGIN{drop=0}
       /^\[/{drop = index(names, " " $0 " ") > 0}
       !drop' "${CONF}" > "${CONF}.steamling-migrate" && cat "${CONF}.steamling-migrate" > "${CONF}"
  rm -f "${CONF}.steamling-migrate"
}
# one blank line before the section, however the file ended
append_stanza() {
  [ -z "$(tail -n 1 "${CONF}")" ] || printf '\n' >> "${CONF}"
  stanza >> "${CONF}"
}

prepare() {
  # no systemd = image-build chroot: rewriting the conf there would strip the repos
  # the rest of the build resolves against
  [ -d /run/systemd/system ] || exit 0
  local now
  now="$(current_stanza)"
  if [ -n "${now}" ]; then
    [ "${now}" = "$(stanza)" ] && exit 0
    # Locked, but to another base: the build moved it (a new host, or our own base replacing the
    # borrowed one). Swap the section and converge onto it like a fresh lock.
    install -d "${STATE}"
    drop_sections '[steamling-base]' '[pocknix-base]'
    append_stanza
    touch "${MARKER}"
    echo "steamling: the base moved to [${BASE_REPO}] at ${BASE_URL}."
    echo "steamling: the device converges onto it on the next connect/boot."
    exit 0
  fi
  # the rolling flag is admin intent — never auto-relock over it
  [ -e /etc/steamling/rolling-mode ] && exit 0
  install -d "${STATE}"
  drop_sections '[core]' '[extra]' '[alarm]' '[aur]'
  append_stanza
  touch "${MARKER}"
  echo "steamling: device is now LOCKED to the steamling base."
  echo "steamling: base convergence runs automatically on the next connect/boot."
}

converge() {
  [ -f "${MARKER}" ] || exit 0
  # pacman refuses the transaction when a versioned dep pins a downgraded lib; record
  # the blocker, or the retry-on-reconnect just looks like a stall
  local out rc=0
  out="$(pacman -Syuu --noconfirm 2>&1)" || rc=$?
  printf '%s\n' "${out}"
  if [ "${rc}" -ne 0 ]; then
    # Foreign compat splits (ALARM's mbedtls3) own the very files the downgrade restores
    # and are orphaned by it: -Rdd exactly those and retry, since the same transaction
    # puts the sonames back. Repo-owned conflicts stay fatal.
    local owners
    owners="$(printf '%s\n' "${out}" \
      | sed -n 's/.*exists in filesystem (owned by \([^)]*\)).*/\1/p' | LC_ALL=C sort -u \
      | LC_ALL=C comm -23 - <(pacman -Slq steamling steamling-shared "${BASE_REPO}" 2>/dev/null | LC_ALL=C sort -u))"
    if [ -n "${owners}" ]; then
      echo "steamling: removing foreign packages superseded by the base:" ${owners}
      # shellcheck disable=SC2086
      pacman -Rdd --noconfirm ${owners} && { rc=0
        out="$(pacman -Syuu --noconfirm 2>&1)" || rc=$?
        printf '%s\n' "${out}"; }
    fi
  fi
  if [ "${rc}" -ne 0 ]; then
    printf '%s\n' "${out}" | sed -n 's/.*required by \([^ ]*\).*/\1/p' | sort -u > "${BLOCKED}"
    [ -s "${BLOCKED}" ] || rm -f "${BLOCKED}"
    echo "steamling: convergence refused — an installed package pins a library newer" >&2
    echo "than the base snapshot (see 'required by <name>' above). Remove it with" >&2
    echo "'pacman -Rs <name>', then re-run 'systemctl start steamling-lock-converge'." >&2
    exit 1
  fi
  rm -f "${BLOCKED}"
  LC_ALL=C comm -23 <(pacman -Qq | LC_ALL=C sort) \
                    <(pacman -Slq steamling steamling-shared "${BASE_REPO}" 2>/dev/null | LC_ALL=C sort -u) > "${FOREIGN}"
  if [ -s "${FOREIGN}" ]; then
    echo "steamling: these packages are not from steamling and will no longer update:"
    sed 's/^/  /' "${FOREIGN}"
    echo "steamling: reinstall desktop apps from Discover (Flatpak), or run"
    echo "steamling: 'sudo steamling-base rolling' to keep managing packages yourself."
  fi
  rm -f "${MARKER}"
  echo "steamling: lock migration complete."
}

case "${1:-}" in
  prepare)  prepare ;;
  converge) converge ;;
  *) echo "usage: steamling-lock-migrate prepare|converge" >&2; exit 1 ;;
esac
