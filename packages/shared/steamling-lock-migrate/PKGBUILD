# steamling-lock-migrate — rolling device -> locked base. The base repo URL and name are stamped
# in at build time (STEAMLING_BASE_URL and STEAMLING_BASE_REPO from build-packages.sh). The URL is
# stable across snapshots, so a bumped base never has to repoint devices; when the build does
# move to another base, the upgrade's prepare swaps the device's section over.
pkgname=steamling-lock-migrate
pkgver=0.1.1
pkgrel=3
pkgdesc="One-shot migration of a rolling steamling device onto the locked base snapshot"
arch=('any')
url="https://github.com/Steamling/steamling"
license=('GPL-2.0-or-later')
depends=('pacman' 'networkmanager' 'steamling-base')
install=steamling-lock-migrate.install
source=('steamling-lock-migrate'
        'steamling-lock-converge.service'
        'steamling-lock-converge-dispatcher')
sha256sums=('SKIP' 'SKIP' 'SKIP')

prepare() {
  [ -n "${STEAMLING_BASE_URL:-}" ] && [ -n "${STEAMLING_BASE_REPO:-}" ] \
    || { echo "STEAMLING_BASE_URL or STEAMLING_BASE_REPO is unset — the migrator needs both" >&2; exit 1; }
  sed -e "s|@STEAMLING_BASE_URL@|${STEAMLING_BASE_URL}|" \
      -e "s|@STEAMLING_BASE_REPO@|${STEAMLING_BASE_REPO}|" \
      -e "s|@STEAMLING_BASE_PARTS@|${STEAMLING_BASE_PARTS:-1}|" "${srcdir}/steamling-lock-migrate" \
    > "${srcdir}/steamling-lock-migrate.stamped"
  grep -q '@STEAMLING_BASE_[A-Z]*@' "${srcdir}/steamling-lock-migrate.stamped" \
    && { echo "placeholder stamping failed" >&2; exit 1; } || true
}

package() {
  install -Dm755 "${srcdir}/steamling-lock-migrate.stamped" \
    "${pkgdir}/usr/lib/steamling/steamling-lock-migrate"
  install -Dm644 "${srcdir}/steamling-lock-converge.service" \
    "${pkgdir}/usr/lib/systemd/system/steamling-lock-converge.service"
  install -Dm755 "${srcdir}/steamling-lock-converge-dispatcher" \
    "${pkgdir}/etc/NetworkManager/dispatcher.d/52-steamling-lock-converge"
}
