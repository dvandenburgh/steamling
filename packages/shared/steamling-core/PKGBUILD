# depends= IS the manifest: pacman never installs a new name on its own (#49). Optional
# layers stay out, or `pacman -Rs <layer>` becomes impossible.
pkgname=steamling-core
pkgver=0.1.1
pkgrel=1
pkgdesc="steamling mandatory layer: GPU stack, input, storage, base/update tooling"
arch=('any')
url="https://github.com/dvandenburgh/steamling"
license=('GPL-2.0-or-later')
depends=('mesa'                     # epoch-2 trimmed/tuned freedreno build ([steamling] outranks ALARM)
         'vulkan-freedreno'
         'inputplumber'             # BSP device configs target it
         'scx-scheds'               # ours from [steamling-shared]: scx_lavd for steamling-lavd.service
         'steamling-sdcard-automount'
         'steamling-snapshots'
         'steamling-base'
         'steamling-base-lock'
         'steamling-lock-migrate'
         'steamling-tools'
         'steamling-branding'         # plymouthd.conf names its theme on every device
         'steamling-gamepad-calibration'  # boot replay of Governor's calibration; every family's pad driver takes one
         'steamling-session')

package() {
  :
}
