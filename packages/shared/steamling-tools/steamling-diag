#!/bin/sh
# Needs no keyboard or network: the report lands on the root fs and the FAT boot partition.
OUT=/var/log/steamling-diag.txt
{
  echo "=== steamling first-boot diagnostic ==="
  date
  printf '\n## uname\n';        uname -a
  printf '\n## /proc/version\n'; cat /proc/version
  printf '\n## /proc/cmdline\n'; cat /proc/cmdline
  printf '\n## root mount\n';    findmnt / 2>/dev/null
  printf '\n## block devices\n'; lsblk -f 2>/dev/null || lsblk
  printf '\n## kernel modules dir\n'; ls /usr/lib/modules 2>/dev/null
  printf '\n## network interfaces\n'; ip -br a 2>/dev/null
  printf '\n## wifi: services alive?\n'
  echo "NetworkManager: $(systemctl is-active NetworkManager 2>/dev/null)  iwd: $(systemctl is-active iwd 2>/dev/null)"
  printf '\n## wifi: rfkill (sysfs)\n'
  for r in /sys/class/rfkill/rfkill*; do
    [ -e "$r/name" ] || continue
    echo "$(cat "$r/name") type=$(cat "$r/type") soft=$(cat "$r/soft") hard=$(cat "$r/hard")"
  done
  printf '\n## wifi: NetworkManager device/conn\n'
  nmcli radio all 2>/dev/null
  nmcli device status 2>/dev/null
  nmcli -f NAME,TYPE,DEVICE connection show 2>/dev/null
  printf '\n## wifi: iwd devices\n'; iwctl device list 2>/dev/null || echo "(iwctl n/a)"
  printf '\n## wifi: connection profile baked?\n'; ls -l /etc/NetworkManager/system-connections/ 2>/dev/null || echo "(none)"
  printf '\n## wifi: profile contents (secrets redacted) — confirms SSID actually baked in\n'
  for f in /etc/NetworkManager/system-connections/*.nmconnection; do
    [ -e "$f" ] || { echo "(NO .nmconnection files — SD_WIFI_SSID didn't reach the build)"; break; }
    echo "--- $f ---"; sed -E 's/^([^=]*(psk|password|wep-key|secret|pin)[^=]*)=.*/\1=<redacted>/' "$f" 2>/dev/null
  done
  printf '\n## wifi: NM conf.d (backend should be iwd; wlan0 NOT unmanaged)\n'
  cat /usr/lib/NetworkManager/conf.d/*.conf /etc/NetworkManager/conf.d/*.conf 2>/dev/null || echo "(none)"
  printf '\n## wifi: iwd main.conf (regdom Country; EnableNetworkConfiguration=false)\n'
  cat /etc/iwd/main.conf 2>/dev/null || echo "(none)"
  printf '\n## wifi: regulatory domain (5 GHz needs a country set)\n'; iw reg get 2>/dev/null || echo "(iw n/a)"
  printf '\n## wifi: scan — does NM see any APs?\n'
  # --rescan no: the list NetworkManager already has. A forced scan on every boot briefly takes the
  # radio off the access point, just as a game or a download is starting.
  nmcli -f SSID,SIGNAL,SECURITY,CHAN device wifi list --rescan no 2>/dev/null | head -30 || echo "(nmcli wifi list n/a)"
  printf '\n## wifi: wlan0 detail\n'
  nmcli device show wlan0 2>/dev/null | grep -E 'GENERAL.STATE|GENERAL.CONNECTION|IP4.ADDRESS|WIFI-PROPERTIES' || true
  nmcli networking connectivity 2>/dev/null
  printf '\n## wifi: iwd station\n'; iwctl station wlan0 show 2>/dev/null || echo "(iwctl n/a)"
  printf '\n## rfkill\n'; rfkill list 2>/dev/null || echo "(rfkill n/a)"
  printf '\n## regulatory.db present?\n'; ls -l /usr/lib/firmware/regulatory.db* 2>/dev/null || echo "MISSING"
  printf '\n## wifi driver dmesg (ath11k or ath12k, depending on the chip)\n'
  dmesg 2>/dev/null | grep -iE 'ath1[12]k' | tail -20
  printf '\n## wifi: FORCED connect attempt (prints the real activation failure reason)\n'
  prof=$(ls /etc/NetworkManager/system-connections/*.nmconnection 2>/dev/null | head -1)
  if nmcli -g GENERAL.STATE device show wlan0 2>/dev/null | grep -q '^100'; then
    # Re-running 'connection up' on an active link tears it down (a wifi blip every boot).
    echo "(wlan0 already connected — skipping forced activation)"
  elif [ -n "$prof" ]; then
    name=$(basename "${prof%.nmconnection}")
    echo "+ nmcli --wait 25 connection up \"$name\""
    nmcli --wait 25 connection up "$name" 2>&1
    echo "--- wlan0 after attempt ---"
    nmcli -f GENERAL.STATE,GENERAL.REASON,GENERAL.CONNECTION,IP4.ADDRESS device show wlan0 2>&1
  else
    echo "(no profile to activate)"
  fi
  printf '\n## NetworkManager journal (activation; iwd phy-capability spam filtered out)\n'
  journalctl -u NetworkManager --no-pager -n 140 2>/dev/null
  printf '\n## iwd journal (state/connect/auth/error events only)\n'
  journalctl -u iwd --no-pager 2>/dev/null | grep -iE 'state:|connect|error|fail|auth|handshake|agent|psk|secret|disconnect' | tail -40
  printf '\n## graphical session: seat / logind (gamescope needs an ACTIVE seat0 session)\n'
  loginctl 2>/dev/null || echo "(loginctl n/a)"
  loginctl session-status 2>/dev/null | head -25 || true
  echo "seatd: $(systemctl is-active seatd 2>/dev/null)  systemd-logind: $(systemctl is-active systemd-logind 2>/dev/null)"
  echo "steamling-session: $(systemctl is-enabled steamling-session 2>/dev/null)/$(systemctl is-active steamling-session 2>/dev/null)  getty@tty1: $(systemctl is-active getty@tty1 2>/dev/null)"
  journalctl -b -u steamling-session --no-pager 2>/dev/null | tail -n 15 || true
  printf '\n## graphical session: processes (etimes = seconds alive; STAT D/Z = stuck; tar/zstd = seed extract)\n'
  ps -eo pid,ppid,stat,etimes,comm 2>/dev/null | grep -iE 'gamescope|steam|Xwayland|kwin|seatd|plasma|tar|zstd|cpio' | grep -v grep || echo "(no gamescope/steam/kwin/tar running)"
  printf '\n## seed extract: Steam dir size (re-run the diag; growing = extract in progress, not hung)\n'
  # Not steamapps: the installed games are tens of GB of files to walk on every boot, and the seed
  # extract this answers only fills the client tree.
  du -sh --exclude=steamapps /home/deck/.local/share/Steam 2>/dev/null || echo "(no ~deck Steam dir yet)"
  # The image build unpacks the seeded client straight into ~deck, so its manifests are the sign.
  ls -1 /home/deck/.local/share/Steam/package/*.installed 2>/dev/null && echo "client installed (seeded, or downloaded on an earlier boot)" || echo "(no client manifest yet -> first launch downloads it)"
  printf '\n## graphical session: which session is selected\n'
  cat /home/deck/.local/state/steamling-session 2>/dev/null || echo "(none -> default gamescope)"
  printf '\n## failed systemd units\n'; systemctl --failed --no-legend 2>/dev/null || true
  printf '\n## gamescope/steam launch log (tail — DRM/seat/atomic errors land here)\n'
  tail -n 120 /home/deck/steamling-steam.log 2>/dev/null || echo "(no ~deck/steamling-steam.log yet — extract still running, or session not launched)"
  printf '\n## gamescope: what is it blocked on? (wchan = kernel wait; D = uninterruptible)\n'
  for p in $(pgrep -x gamescope 2>/dev/null); do
    echo "gamescope pid $p: state=$(cut -d' ' -f3 /proc/$p/stat 2>/dev/null) wchan=$(cat /proc/$p/wchan 2>/dev/null)"
  done || echo "(no gamescope process)"
  printf '\n## steam client logs (tail)\n'
  for L in /home/deck/.local/share/Steam/logs/bootstrap_log.txt /home/deck/.local/share/Steam/logs/stderr.txt /home/deck/.steam/steam/logs/bootstrap_log.txt; do
    [ -f "$L" ] && { echo "--- $L ---"; tail -n 25 "$L" 2>/dev/null; }
  done
  printf '\n## dmesg DRM/msm/gpu (gamescope display acquisition)\n'
  dmesg 2>/dev/null | grep -iE 'msm|drm|adreno|gpu|atomic|a740' | tail -40

  printf '\n## desktop mode: the latest attempt (this boot if it is running now, else the previous boot)\n'
  # A black desktop usually ends in a held power button, so the evidence is in the previous
  # boot's persistent journal; this report runs on the next boot and picks it up.
  deck_uid=$(id -u deck 2>/dev/null || echo 1001)
  if pgrep -u "$deck_uid" -x kwin_wayland >/dev/null 2>&1 || pgrep -u "$deck_uid" -f startplasma >/dev/null 2>&1; then B=0; else B=-1; fi
  echo "journal boot: $B   (0 = desktop running right now)"
  echo "picked desktop: $(cat /home/deck/.config/steamling/desktop-session 2>/dev/null || echo '(default)')"
  echo "sessions: $(ls /usr/share/wayland-sessions 2>/dev/null | tr '\n' ' ')"
  for L in /home/deck/steamling-session.log.prev /home/deck/steamling-session.log; do
    [ -f "$L" ] && grep -q 'steamling-desktop' "$L" 2>/dev/null && { echo "--- $L (a desktop launch) ---"; tail -n 150 "$L"; }
  done
  echo "--- session supervisor, boot $B ---"
  journalctl -b "$B" -u steamling-session --no-pager 2>/dev/null | grep -iE 'desktop|plasma|kwin|display|exiting|fast' | tail -n 30
  echo "--- deck's journal, boot $B: kwin / plasma / display ---"
  journalctl -b "$B" _UID="$deck_uid" --no-pager 2>/dev/null \
    | grep -iE 'kwin|plasma|startplasma|powerdevil|kscreen|drm|egl|gbm|gles|opengl|brightness|backlight|xwayland|wayland|segfault|core dump|abort|failed|error' \
    | grep -viE 'steamwebhelper|gamescope' | tail -n 250
  echo "--- user units that failed, boot $B ---"
  journalctl -b "$B" _UID="$deck_uid" --no-pager 2>/dev/null | grep -E 'Failed with result|Main process exited|code=dumped' | tail -n 30
  echo "--- crashes ---"
  coredumpctl --no-pager list 2>/dev/null | tail -n 15 || echo "(coredumpctl n/a)"
  echo "--- kernel display messages, boot $B ---"
  journalctl -k -b "$B" --no-pager 2>/dev/null | grep -iE 'msm|dpu|dsi|drm|panel|backlight|a740|adreno' | tail -n 60
  echo "--- backlight now ---"
  for b in /sys/class/backlight/*; do
    [ -e "$b/brightness" ] && echo "$(basename "$b"): brightness=$(cat "$b/brightness") actual=$(cat "$b/actual_brightness" 2>/dev/null) max=$(cat "$b/max_brightness") bl_power=$(cat "$b/bl_power" 2>/dev/null)"
  done
  echo "--- kwin output config ---"
  cat /home/deck/.config/kwinoutputconfig.json 2>/dev/null | head -n 60 || echo "(none)"
  if [ "$B" = 0 ]; then
    echo "--- DRM state while the desktop runs (are a CRTC and a plane on?) ---"
    mountpoint -q /sys/kernel/debug || mount -t debugfs debugfs /sys/kernel/debug 2>/dev/null
    head -n 120 /sys/kernel/debug/dri/0/state 2>/dev/null || echo "(no debugfs DRM state)"
  fi

  printf '\n## board (dt model / panel)\n'
  echo "model: $(tr -d '\0' < /proc/device-tree/model 2>/dev/null)"
  for pn in /sys/firmware/devicetree/base/soc@0/display-subsystem@*/dsi@*/panel@0/compatible; do
    [ -e "$pn" ] && echo "panel compatible: $(tr '\0' ' ' < "$pn")"
  done
  for c in /sys/class/drm/card*-*; do
    [ -e "$c/status" ] && echo "$(basename "$c"): $(cat "$c/status") $(cat "$c/enabled" 2>/dev/null)"
  done
  echo "board file: $(/usr/lib/steamling/steamling-board-env 2>/dev/null | sed -n 's/^STEAMLING_DEVICE=//p')"
  ( . /usr/lib/steamling/device.conf 2>/dev/null
    [ "${STEAMLING_BOARD_UNKNOWN:-0}" = 1 ] && echo "board file: NOT MATCHED, this model fell back to the family default"
    echo "panel: ${STEAMLING_PANEL_W}x${STEAMLING_PANEL_H}@${STEAMLING_PANEL_REFRESH} orient=${STEAMLING_PANEL_ORIENT} output=${STEAMLING_PANEL_OUTPUT}" )
  printf '\n## controls: InputPlumber virtual pads (name, then the source and target devices)\n'
  echo "inputplumber: $(systemctl is-active inputplumber 2>/dev/null)"
  echo "gyro: steamling-ssc $(systemctl is-active steamling-ssc 2>/dev/null), $(cat /run/steamling/gyro.env 2>/dev/null | tr '\n' ' ')"
  journalctl -b -u inputplumber --no-pager -o cat 2>/dev/null | grep -iE 'ssc|fastrpc|imu' | tail -n 8
  for cd in $(busctl --system tree org.shadowblip.InputPlumber 2>/dev/null | grep -o '/org/shadowblip/InputPlumber/CompositeDevice[0-9]*' | sort -u); do
    echo "$cd: $(busctl --system get-property org.shadowblip.InputPlumber "$cd" org.shadowblip.Input.CompositeDevice Name 2>/dev/null)"
    echo "  sources: $(busctl --system get-property org.shadowblip.InputPlumber "$cd" org.shadowblip.Input.CompositeDevice SourceDevicePaths 2>/dev/null)"
    for t in $(busctl --system get-property org.shadowblip.InputPlumber "$cd" org.shadowblip.Input.CompositeDevice TargetDevices 2>/dev/null | grep -o '"[^"]*"' | tr -d '"'); do
      echo "  target: $t $(busctl --system get-property org.shadowblip.InputPlumber "$t" org.shadowblip.Input.Target DeviceType 2>/dev/null)"
    done
  done
  printf '\n## input devices the kernel sees (name / phys)\n'
  grep -E '^N: |^P: ' /proc/bus/input/devices 2>/dev/null | paste - - | sed 's/N: Name=//; s/\tP: Phys=/  phys=/'
  printf '\n## audio: sound cards (the UCM profile is picked by these names)\n'
  cat /proc/asound/cards 2>/dev/null || echo "(no sound cards)"
  wpctl status 2>/dev/null | sed -n '/^Audio/,/^Video/p' | head -30
  printf '\n## battery and fan\n'
  for ps in /sys/class/power_supply/*; do
    [ -e "$ps/type" ] || continue
    echo "$(basename "$ps"): type=$(cat "$ps/type") status=$(cat "$ps/status" 2>/dev/null) capacity=$(cat "$ps/capacity" 2>/dev/null) online=$(cat "$ps/online" 2>/dev/null)"
  done
  for h in /sys/class/hwmon/hwmon*; do
    [ -e "$h/name" ] || continue
    { [ -e "$h/fan1_input" ] || [ -e "$h/pwm1" ]; } && echo "$(cat "$h/name"): fan=$(cat "$h"/fan1_input 2>/dev/null) pwm=$(cat "$h"/pwm1 2>/dev/null)"
  done
  printf '\n## suspend support\n'
  echo "pm_async: $(cat /sys/power/pm_async 2>/dev/null)"
  echo "mem_sleep: $(cat /sys/power/mem_sleep 2>/dev/null)"
  echo "state:     $(cat /sys/power/state 2>/dev/null)"
  printf '\n## dmesg errors/warnings (tail)\n'; dmesg --level=err,warn 2>/dev/null | tail -100
} > "$OUT" 2>&1

# The boot partition of the disk we booted from is already mounted at /flash. Only when it isn't
# go looking by label, and never by a generic name like "system", which on some Android layouts
# is Android's own partition.
if mountpoint -q /flash; then
  cp "$OUT" /flash/steamling-diag.txt 2>/dev/null && sync
else
  mp=$(mktemp -d)
  if mount -L STEAMLING "$mp" 2>/dev/null || mount -L ROCKNIX "$mp" 2>/dev/null; then
    cp "$OUT" "$mp/steamling-diag.txt" 2>/dev/null || true
    sync
    umount "$mp" 2>/dev/null || true
  fi
  rmdir "$mp" 2>/dev/null || true
fi
