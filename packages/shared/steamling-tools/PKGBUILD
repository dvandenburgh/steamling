# steamling-tools — the desktop maintenance app. It also ships the internal-install CLIs,
# which live here rather than in the image overlay so fixes reach fielded SDs on -Syu (#34).
pkgname=steamling-tools
pkgver=0.1.1
pkgrel=1.2
pkgdesc="Steamling maintenance app: snapshot rollback, base mode switch, internal install, SSH, file sharing and USB file transfer toggles, emulation layer, desktop picker, first-boot diagnostics and root expansion"
arch=('any')
url="https://github.com/dvandenburgh/steamling"
license=('GPL-2.0-or-later')
depends=('steamling-snapshots' 'steamling-base' 'kdialog' 'cloud-guest-utils'  # growpart: steamling-expand-root
         'umtp-responder'  # steamling-mtp
         'python')  # steamling-bench
install=steamling-tools.install
source=('steamling-tools' 'steamling-tools.desktop' 'steamling-installer-gui'
        'steamling-install-internal' 'steamling-uninstall-internal' '54-steamling-installer.rules'
        'steamling-internal-boot-rename' 'steamling-internal-boot-rename.service'
        'steamling-ssh' '53-steamling-ssh.rules' '10-steamling-no-root-login.conf'
        'steamling-share' '55-steamling-share.rules' 'smb.conf' 'steamling-smb.service'
        'steamling-layer' '56-steamling-layer.rules'
        'steamling-diag' 'steamling-diag.service' 'steamling-expand-root' 'steamling-expand-root.service'
        'steamling-mtp' 'steamling-mtp.service' 'steamling-bench')
sha256sums=('SKIP' 'SKIP' 'SKIP' 'SKIP' 'SKIP' 'SKIP' 'SKIP' 'SKIP'
            'SKIP' 'SKIP' 'SKIP' 'SKIP' 'SKIP' 'SKIP' 'SKIP' 'SKIP' 'SKIP' 'SKIP' 'SKIP' 'SKIP' 'SKIP' 'SKIP' 'SKIP'
            'SKIP')
backup=('etc/ssh/sshd_config.d/10-steamling-no-root-login.conf'
        'etc/samba/smb.conf')

package() {
  install -Dm755 "${srcdir}/steamling-tools" "${pkgdir}/usr/bin/steamling-tools"
  install -Dm755 "${srcdir}/steamling-installer-gui" "${pkgdir}/usr/bin/steamling-installer-gui"
  install -Dm755 "${srcdir}/steamling-install-internal" "${pkgdir}/usr/bin/steamling-install-internal"
  install -Dm755 "${srcdir}/steamling-uninstall-internal" "${pkgdir}/usr/bin/steamling-uninstall-internal"
  # ROCKNIX->STEAMLING boot-partition migration, statically enabled via wants symlink
  install -Dm755 "${srcdir}/steamling-internal-boot-rename" "${pkgdir}/usr/bin/steamling-internal-boot-rename"
  install -Dm644 "${srcdir}/steamling-internal-boot-rename.service" \
    "${pkgdir}/usr/lib/systemd/system/steamling-internal-boot-rename.service"
  install -d "${pkgdir}/usr/lib/systemd/system/local-fs.target.wants"
  ln -s ../steamling-internal-boot-rename.service \
    "${pkgdir}/usr/lib/systemd/system/local-fs.target.wants/steamling-internal-boot-rename.service"
  install -Dm644 "${srcdir}/54-steamling-installer.rules" \
    "${pkgdir}/usr/share/polkit-1/rules.d/54-steamling-installer.rules"
  install -Dm755 "${srcdir}/steamling-ssh" "${pkgdir}/usr/bin/steamling-ssh"
  install -Dm644 "${srcdir}/steamling-tools.desktop" \
    "${pkgdir}/usr/share/applications/steamling-tools.desktop"
  install -Dm644 "${srcdir}/53-steamling-ssh.rules" \
    "${pkgdir}/usr/share/polkit-1/rules.d/53-steamling-ssh.rules"
  install -Dm644 "${srcdir}/10-steamling-no-root-login.conf" \
    "${pkgdir}/etc/ssh/sshd_config.d/10-steamling-no-root-login.conf"

  install -Dm755 "${srcdir}/steamling-share" "${pkgdir}/usr/bin/steamling-share"
  install -Dm644 "${srcdir}/55-steamling-share.rules" \
    "${pkgdir}/usr/share/polkit-1/rules.d/55-steamling-share.rules"
  # samba ships no default smb.conf (only empty /etc/samba), so this is the whole config
  install -Dm644 "${srcdir}/smb.conf" "${pkgdir}/etc/samba/smb.conf"
  install -Dm644 "${srcdir}/steamling-smb.service" \
    "${pkgdir}/etc/avahi/services/steamling-smb.service"

  # Before-and-after measurements for system changes (docs/benchmarking.md).
  install -Dm755 "${srcdir}/steamling-bench" "${pkgdir}/usr/bin/steamling-bench"

  # Started on request only (Governor), never enabled: see the unit.
  install -Dm755 "${srcdir}/steamling-mtp" "${pkgdir}/usr/bin/steamling-mtp"
  install -Dm644 "${srcdir}/steamling-mtp.service" \
    "${pkgdir}/usr/lib/systemd/system/steamling-mtp.service"

  install -Dm755 "${srcdir}/steamling-layer" "${pkgdir}/usr/bin/steamling-layer"
  install -Dm644 "${srcdir}/56-steamling-layer.rules" \
    "${pkgdir}/usr/share/polkit-1/rules.d/56-steamling-layer.rules"

  install -Dm755 "${srcdir}/steamling-diag" "${pkgdir}/usr/bin/steamling-diag"
  install -Dm644 "${srcdir}/steamling-diag.service" \
    "${pkgdir}/usr/lib/systemd/system/steamling-diag.service"
  install -d "${pkgdir}/usr/lib/systemd/system/multi-user.target.wants"
  ln -s ../steamling-diag.service \
    "${pkgdir}/usr/lib/systemd/system/multi-user.target.wants/steamling-diag.service"
  # Not enabled here: growing the root is the SD image's first-boot step, which the image enables.
  install -Dm755 "${srcdir}/steamling-expand-root" "${pkgdir}/usr/lib/steamling/steamling-expand-root"
  install -Dm644 "${srcdir}/steamling-expand-root.service" \
    "${pkgdir}/usr/lib/systemd/system/steamling-expand-root.service"
}
