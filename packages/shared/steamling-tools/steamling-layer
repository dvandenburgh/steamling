#!/bin/bash
# steamling-layer - install/remove the emulation layer or the desktop Plasma flavour. status stays
# unprivileged (the menu polls it); the rest arrives via pkexec under this program's own rule,
# never a bare `pkexec pacman`.
set -euo pipefail

META=steamling-emulation-full
# optdepends of the meta: -S/-Rs do not follow them, so they are handled by name
OPTIONAL=(dolphin-emu azahar cemu)
UNIT=steamling-roms-init.service

need_root() { [ "$(id -u)" -eq 0 ] || { echo "steamling-layer: must run as root" >&2; exit 1; }; }
meta_installed() { pacman -Q "${META}" >/dev/null 2>&1; }
esde_installed() { [ -x /usr/bin/es-de ]; }
installed() { meta_installed || esde_installed; }

# a device fielded before the layer metas has the members but no meta, hence the sync-db fallback
members() {
  local src p
  if meta_installed; then src="$(pacman -Qi "${META}")"; else src="$(pacman -Si "${META}" 2>/dev/null || true)"; fi
  # awk, not sed: pacman wraps a long list onto indented continuation lines on a tty
  printf '%s\n' "${src}" \
    | awk -F' *: *' '/^Depends On/{f=1; print $2; next} /^[A-Z][A-Za-z ]+ *:/{f=0} f{print}' \
    | tr ' ' '\n' | sed 's/[<>=].*//' \
    | while IFS= read -r p; do
        [ -n "${p}" ] && [ "${p}" != None ] && pacman -Q "${p}" >/dev/null 2>&1 && echo "${p}"
      done
}

# Both layers install from Steamling's own repos: the package repo, or the build PC on a handheld
# pointed at one (docs/building/updating-from-your-pc.md). pacman -Syu stops with a bare "failed
# to retrieve" when one can't be reached, so check first and say what to do.
check_repos() {
  local repo url bad="" lan=""
  for repo in steamling steamling-shared; do
    url="$(pacman-conf --repo "${repo}" Server 2>/dev/null | head -1)"
    if [ -z "${url}" ]; then
      echo "steamling-layer: this handheld has no [${repo}] repo, which is where these packages come from." >&2
      echo "  Run 'sudo steamling-base repo' to add Steamling's package repos, then try again." >&2
      exit 1
    fi
    case "${url}" in
      http://*|https://*)
        if ! curl -sf -o /dev/null -I --max-time 8 "${url}/${repo}.db"; then
          bad+=" ${url}"
          case "${url}" in https://github.com/*) ;; *) lan=1 ;; esac
        fi ;;
    esac
  done
  if [ -n "${bad}" ]; then
    echo "steamling-layer: can't reach${bad}" >&2
    if [ -n "${lan}" ]; then
      echo "  That's your build PC: start the package server there" >&2
      echo "  (docs/building/updating-from-your-pc.md, step 2), check the handheld can reach it, and try again." >&2
    else
      echo "  Check the handheld is online and try again." >&2
    fi
    exit 1
  fi
}

# RemainAfterExit makes `start` a no-op once run: restart the seeder for the user who asked
user_systemctl() {
  local u; u="$(id -nu "${PKEXEC_UID:-1001}" 2>/dev/null)" || return 1
  systemctl --machine="${u}@.host" --user "$@"
}
kick_seeder() {
  user_systemctl daemon-reload 2>/dev/null || true
  user_systemctl restart "${UNIT}" 2>/dev/null \
    || echo "steamling-layer: could not run the config seeder now; log out and back in once"
}

# Opt-in flavour: no optdepends and no seeder, and -Rs takes its Plasma deps with it.
if [ "${2:-emulation}" = desktop-plasma ]; then
  FLAVOUR=steamling-desktop-plasma
  case "${1:-status}" in
    status)  pacman -Q "${FLAVOUR}" >/dev/null 2>&1 && echo "installed=yes" || echo "installed=no" ;;
    install) need_root; check_repos; pacman -Syu --noconfirm "${FLAVOUR}"; echo "installed=yes" ;;
    remove)  need_root; pacman -Rs --noconfirm "${FLAVOUR}"; echo "installed=no" ;;
    *)       echo "usage: steamling-layer {status|install|remove} [emulation|desktop-plasma]" >&2; exit 2 ;;
  esac
  exit 0
fi

case "${1:-status}" in
  status)
    meta_installed && echo "meta=yes" || echo "meta=no"
    esde_installed && echo "esde=yes" || echo "esde=no"
    installed && echo "installed=yes" || echo "installed=no"
    ;;
  install)
    need_root
    check_repos
    # -Syu, never -Sy: a refreshed index on an un-upgraded system is the partial-upgrade trap
    pacman -Syu --noconfirm "${META}"
    for p in "${OPTIONAL[@]}"; do
      pacman -S --needed --noconfirm "${p}" || echo "steamling-layer: optional ${p} skipped (not published for this build)"
    done
    kick_seeder
    echo "installed=yes"
    ;;
  remove)
    need_root
    installed || { echo "installed=no"; exit 0; }
    mapfile -t m < <(members)
    for p in "${OPTIONAL[@]}"; do pacman -Q "${p}" >/dev/null 2>&1 && m+=("${p}"); done
    # members are explicitly installed on pre-meta devices, which -Rs would protect
    [ "${#m[@]}" -gt 0 ] && pacman -D --asdeps "${m[@]}" >/dev/null
    # name only members nothing else needs (fuse2 serves fex-emu too); -Rs cascades the rest
    orphans=" $(pacman -Qdtq 2>/dev/null | tr '\n' ' ') "
    targets=()
    meta_installed && targets+=("${META}")
    for p in "${m[@]}"; do case "${orphans}" in *" ${p} "*) targets+=("${p}") ;; esac; done
    [ "${#targets[@]}" -gt 0 ] || { echo "steamling-layer: nothing removable" >&2; exit 1; }
    # never touch ~/Emulation, ~/ES-DE, config dirs or the baseline: a reinstall must merge
    pacman -Rs --noconfirm "${targets[@]}"
    user_systemctl daemon-reload 2>/dev/null || true
    echo "installed=no"
    ;;
  *)
    echo "usage: steamling-layer {status|install|remove} [emulation|desktop-plasma]" >&2
    exit 2
    ;;
esac
