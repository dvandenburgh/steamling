From 62c89fff00a2f5e2be483fee0314bffb002f03b7 Mon Sep 17 00:00:00 2001
From: Danylo Piliaiev <dpiliaiev@igalia.com>
Date: Mon, 23 Nov 2026 16:10:51 +0100
Subject: [PATCH] tu: Write occlusion query availability after the accumulated
 result

ZPASS_DONE with write_accum_sample_count_diff accumulates the result
asynchronously, and WFI/WFM/WAIT_FOR_MEM_WRITES don't wait for that
write to land.
Thus write availability through RB_DONE_TS which is guaranteed to be
correctly ordered.

Fixes flaky:
```
dEQP-VK.query_pool.occlusion_query.*
```

Fixes: 9845e99960a ("tu: avoid memory polling in occlusion query endings using ZPASS_DONE")
Assisted-by: LLM
Signed-off-by: Danylo Piliaiev <dpiliaiev@igalia.com>
Part-of: <https://gitlab.freedesktop.org/mesa/mesa/-/merge_requests/46637>

Steamling: rebased onto 26.3.1, where emit_end_occlusion_query() writes
the availability through epilogue_cs rather than reassigning cs.
---
 src/freedreno/vulkan/tu_query_pool.cc | 20 +++++++++++++++++---
 1 file changed, 17 insertions(+), 3 deletions(-)

diff --git a/src/freedreno/vulkan/tu_query_pool.cc b/src/freedreno/vulkan/tu_query_pool.cc
--- a/src/freedreno/vulkan/tu_query_pool.cc
+++ b/src/freedreno/vulkan/tu_query_pool.cc
@@ -1601,9 +1601,23 @@
       }
    }
 
-   tu_cs_emit_pkt7(epilogue_cs, CP_MEM_WRITE, 4);
-   tu_cs_emit_qw(epilogue_cs, available_iova);
-   tu_cs_emit_qw(epilogue_cs, 0x1);
+   if (cmdbuf->device->physical_device->info->props.has_event_write_sample_count) {
+      /* ZPASS_DONE with write_accum_sample_count_diff accumulates the result asynchronously,
+       * and WFI/WFM/WAIT_FOR_MEM_WRITES don't waits for that write to land.
+       * Thus write availability through RB_DONE_TS which is guaranteed to be correctly ordered.
+       */
+      tu_cs_emit_pkt7(epilogue_cs, CP_EVENT_WRITE7, 4);
+      tu_cs_emit(epilogue_cs, CP_EVENT_WRITE7_0(.event = RB_DONE_TS,
+                                                .write_src = EV_WRITE_USER_32B,
+                                                .write_dst = EV_DST_RAM,
+                                                .write_enabled = true).value);
+      tu_cs_emit_qw(epilogue_cs, available_iova);
+      tu_cs_emit(epilogue_cs, 0x1);
+   } else {
+      tu_cs_emit_pkt7(epilogue_cs, CP_MEM_WRITE, 4);
+      tu_cs_emit_qw(epilogue_cs, available_iova);
+      tu_cs_emit_qw(epilogue_cs, 0x1);
+   }
 
    cmdbuf->state.occlusion_query_may_be_running = false;
    cmdbuf->state.dirty |= TU_CMD_DIRTY_DISABLE_FS | TU_CMD_DIRTY_LRZ;
