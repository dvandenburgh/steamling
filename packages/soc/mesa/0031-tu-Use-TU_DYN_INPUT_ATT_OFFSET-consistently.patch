From a54c80d04d37b5540897d00f39647a11156693af Mon Sep 17 00:00:00 2001
From: Karmjit Mahil <karmjit.mahil@igalia.com>
Date: Wed, 11 Nov 2026 15:44:20 +0000
Subject: [PATCH] tu: Use TU_DYN_INPUT_ATT_OFFSET consistently

Generated-by: LLM
Signed-off-by: Karmjit Mahil <karmjit.mahil@igalia.com>
Part-of: <https://gitlab.freedesktop.org/mesa/mesa/-/merge_requests/46194>
---
 src/freedreno/vulkan/tu_cmd_buffer.cc | 3 +--
 src/freedreno/vulkan/tu_lrz.cc        | 2 +-
 src/freedreno/vulkan/tu_pass.cc       | 7 +++----
 src/freedreno/vulkan/tu_pipeline.cc   | 4 ++--
 src/freedreno/vulkan/tu_shader.cc     | 8 ++++----
 5 files changed, 11 insertions(+), 13 deletions(-)

diff --git a/src/freedreno/vulkan/tu_cmd_buffer.cc b/src/freedreno/vulkan/tu_cmd_buffer.cc
index e9c745416166..3a1fc0a600f2 100644
--- a/src/freedreno/vulkan/tu_cmd_buffer.cc
+++ b/src/freedreno/vulkan/tu_cmd_buffer.cc
@@ -8258,8 +8258,7 @@ tu_fs_reads_dynamic_ds_input_attachment(struct tu_cmd_buffer *cmd,
    uint8_t depth_att = cmd->vk.dynamic_graphics_state.ial.depth_att;
    if (depth_att == MESA_VK_ATTACHMENT_UNUSED)
       return false;
-   unsigned depth_idx =
-      (depth_att == MESA_VK_ATTACHMENT_NO_INDEX) ? 0 : depth_att + 1;
+   unsigned depth_idx = (depth_att == MESA_VK_ATTACHMENT_NO_INDEX) ? 0 : depth_att + TU_DYN_INPUT_ATT_OFFSET;
    return fs->fs.dynamic_input_attachments_used & (1u << depth_idx);
 }
 
diff --git a/src/freedreno/vulkan/tu_lrz.cc b/src/freedreno/vulkan/tu_lrz.cc
index 1ae27c2475f3..92b24538f066 100644
--- a/src/freedreno/vulkan/tu_lrz.cc
+++ b/src/freedreno/vulkan/tu_lrz.cc
@@ -1208,7 +1208,7 @@ tu_has_potential_stencil_feedback_loop(struct tu_cmd_buffer *cmd, const struct t
    if (stencil_att == MESA_VK_ATTACHMENT_UNUSED)
       return false;
 
-   unsigned stencil_idx = stencil_att == MESA_VK_ATTACHMENT_NO_INDEX ? 0 : stencil_att + 1;
+   unsigned stencil_idx = stencil_att == MESA_VK_ATTACHMENT_NO_INDEX ? 0 : stencil_att + TU_DYN_INPUT_ATT_OFFSET;
    return fs->fs.dynamic_input_attachments_used & (1u << stencil_idx);
 }
 
diff --git a/src/freedreno/vulkan/tu_pass.cc b/src/freedreno/vulkan/tu_pass.cc
index 8076bf4cb7d6..613ccf51eac4 100644
--- a/src/freedreno/vulkan/tu_pass.cc
+++ b/src/freedreno/vulkan/tu_pass.cc
@@ -1522,7 +1522,7 @@ tu_setup_dynamic_render_pass(struct tu_cmd_buffer *cmd_buffer,
 
       if (att_info->imageView == VK_NULL_HANDLE) {
          subpass->color_attachments[i].attachment = VK_ATTACHMENT_UNUSED;
-         subpass->input_attachments[i + 1].attachment = VK_ATTACHMENT_UNUSED;
+         subpass->input_attachments[i + TU_DYN_INPUT_ATT_OFFSET].attachment = VK_ATTACHMENT_UNUSED;
          if (subpass->resolve_attachments)
             subpass->resolve_attachments[i].attachment = VK_ATTACHMENT_UNUSED;
          if (pass->subpass_count > 1) {
@@ -1566,13 +1566,12 @@ tu_setup_dynamic_render_pass(struct tu_cmd_buffer *cmd_buffer,
          attachment_set_ops(device, att, att_info->loadOp,
                             VK_ATTACHMENT_LOAD_OP_NONE, att_info->storeOp,
                             VK_ATTACHMENT_STORE_OP_NONE);
-         subpass->input_attachments[i + 1].patch_input_gmem = true;
+         subpass->input_attachments[i + TU_DYN_INPUT_ATT_OFFSET].patch_input_gmem = true;
          subpass->unresolve_attachments[i].attachment = VK_ATTACHMENT_UNUSED;
          subpass->samples = static_cast<VkSampleCountFlagBits>(view->image->layout->nr_samples);
       }
       subpass->color_attachments[i].attachment = att_idx;
-      subpass->input_attachments[i + 1].attachment = att_idx;
-
+      subpass->input_attachments[i + TU_DYN_INPUT_ATT_OFFSET].attachment = att_idx;
 
       if (vk_format_is_srgb(view->vk.format))
          subpass->srgb_cntl |= 1 << i;
diff --git a/src/freedreno/vulkan/tu_pipeline.cc b/src/freedreno/vulkan/tu_pipeline.cc
index 5f06dd5dadb5..6b1446dbfa47 100644
--- a/src/freedreno/vulkan/tu_pipeline.cc
+++ b/src/freedreno/vulkan/tu_pipeline.cc
@@ -1844,14 +1844,14 @@ tu_pipeline_builder_compile_shaders(struct tu_pipeline_builder *builder,
          if (ial->depth_att == MESA_VK_ATTACHMENT_NO_INDEX)
             attachments_referenced |= 1;
          else
-            attachments_referenced |= 1u << (ial->depth_att + 1);
+            attachments_referenced |= 1u << (ial->depth_att + TU_DYN_INPUT_ATT_OFFSET);
       }
 
       if (ial->stencil_att != MESA_VK_ATTACHMENT_UNUSED) {
          if (ial->stencil_att == MESA_VK_ATTACHMENT_NO_INDEX)
             attachments_referenced |= 1;
          else
-            attachments_referenced |= 1u << (ial->stencil_att + 1);
+            attachments_referenced |= 1u << (ial->stencil_att + TU_DYN_INPUT_ATT_OFFSET);
       }
 
       keys[MESA_SHADER_FRAGMENT].read_only_input_attachments =
diff --git a/src/freedreno/vulkan/tu_shader.cc b/src/freedreno/vulkan/tu_shader.cc
index b7534bee77da..248d776a24d7 100644
--- a/src/freedreno/vulkan/tu_shader.cc
+++ b/src/freedreno/vulkan/tu_shader.cc
@@ -1096,9 +1096,9 @@ lower_input_attachment(nir_builder *b, nir_tex_instr *tex,
                        bool dynamic_renderpass)
 {
    if (dynamic_renderpass &&
-       ((tex->input_attachment_depth || tex->input_attachment_stencil) ?
-        (read_only_input_attachments & 0x1) :
-        (read_only_input_attachments & (1u << (tex->texture_index + 1)))))
+       ((tex->input_attachment_depth || tex->input_attachment_stencil)
+           ? (read_only_input_attachments & 0x1)
+           : (read_only_input_attachments & (1u << (tex->texture_index + TU_DYN_INPUT_ATT_OFFSET)))))
       return false;
 
    if (TU_DEBUG(DYNAMIC))
@@ -1117,7 +1117,7 @@ lower_input_attachment(nir_builder *b, nir_tex_instr *tex,
       assert(dynamic_renderpass);
       idx = 1;
    } else if (dynamic_renderpass) {
-      idx = (tex->texture_index + 1) * 2;
+      idx = (tex->texture_index + TU_DYN_INPUT_ATT_OFFSET) * 2;
       /* D24S8 workaround: stencil of D24S8 will be sampled as uint */
       if (nir_alu_type_get_base_type(tex->dest_type) != nir_type_float)
          idx += 1;
-- 
