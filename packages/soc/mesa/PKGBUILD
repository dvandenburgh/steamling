# mesa (steamling) — Mesa trimmed to freedreno GL + turnip Vulkan, CPU-tuned per SoC.
# x11+GLX stays enabled: Steam and desktop apps run under XWayland and need GLX/EGL-x11.
# epoch=2 outranks ALARM's epoch=1 mesa.
pkgbase=mesa
pkgname=(mesa vulkan-freedreno)
epoch=2
pkgver=26.3.1
_srcver=${pkgver}
pkgrel=2
pkgdesc="Mesa trimmed for Qualcomm handhelds: freedreno GL + turnip Vulkan, SoC-tuned (${pkgver})"
arch=('aarch64')
url="https://www.mesa3d.org/"
license=("MIT AND BSD-3-Clause AND SGI-B-2.0")
# glslang: newer mesa folds freedreno into the BVH shader set, so glslangValidator is a hard
# requirement of any build with vulkan-drivers=freedreno.
makedepends=(
  meson ninja python-mako python-packaging python-yaml python-ply glslang
  expat libdrm libglvnd libdisplay-info spirv-tools systemd-libs vulkan-icd-loader
  wayland wayland-protocols zlib zstd
  xorgproto libx11 libxcb libxext libxshmfence libxxf86vm libxrandr xcb-util-keysyms
)
# upstream considers LTO broken until explicit notice
options=(!lto)
# Turnip and freedreno fixes the 26.3 branch does not have yet. 0001 is still an open merge request
# and 0002 is on main only; 0004 is a shader compiler crash fix armada carries
# until upstream has one; 0005 and 0010 are on main only; 0011/0012
# fix A8xx GL hangs with no upstream fix yet (PATCHES.md says where each comes from). Each stays
# until a release has it (gaps in the numbers are patches a release took). 0013 is the other half of steamling-steam's
# GAMESCOPE_LIMITER_FILE and is kept across Mesa releases. 0014/0015 let freedreno GL time GMEM
# against sysmem on A7xx and up and keep the faster one; FD_AUTOTUNE_ALGO=samples turns it off.
# 0016/0017 fix shader integer division that came out wrong for some large divisors (main only).
# 0018/0019 keep Turnip images a game may view in a second format tiled and compressed on the
# A740 and older, where upstream stores them linear; TU_Z_MUTABLE=0 goes back to upstream's layout.
# 0020 is the one Turnip fix the previous series had that this branch has not picked up.
# 0022 fixes a use-after-free when Turnip fails to place a descriptor set in its pool (main only).
source=("https://archive.mesa3d.org/mesa-${_srcver}.tar.xz"
