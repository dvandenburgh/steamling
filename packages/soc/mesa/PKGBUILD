        '0002-tu-Add-numnonposvar-alignment-quirk-for-a7xx-gen1-gen2.patch'
        '0003-freedreno-Don-t-double-close-imported-syncobj-fd.patch'
        '0004-ir3-array_to_ssa-follow-trivial-phi-chains.patch'
        '0005-freedreno-Take-only-in-fence-as-a-hint-for-explicit-sync.patch'
