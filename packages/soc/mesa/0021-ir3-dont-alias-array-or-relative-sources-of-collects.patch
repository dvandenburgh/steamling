From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: Job Noorman <jnoorman@igalia.com>
Subject: [PATCH] ir3: don't alias array sources, also when they feed a collect

alias.tex can't take an array register, and the sources of a collect or
mov feeding a texture instruction were never checked for one, since the
check only looked at the collect's destination. Enshrouded hit it and
failed shader validation.

Backport of three commits from main: 79cb50651251 ("ir3: add
has_valid_alias_flags helper"), 2bbd85f5484d ("ir3: check src flags of
aliased collects") and 1446d7f9e755 ("ir3: don't create aliases for
array srcs"), squashed into the end state, with 26.3's one-argument
is_same_type_mov().

Fixes: 3fb0f54d706 ("ir3: add support for alias.tex")
---
diff --git a/src/freedreno/ir3/ir3_alias.c b/src/freedreno/ir3/ir3_alias.c
index 80543d8..cb709b1 100644
--- a/src/freedreno/ir3/ir3_alias.c
+++ b/src/freedreno/ir3/ir3_alias.c
@@ -24,35 +24,43 @@ supports_alias_srcs(struct ir3_instruction *instr)
    return true;
 }
 
+static bool
+has_valid_alias_flags(struct ir3_register *src)
+{
+   /* We haven't seen any indication that aliasing supports the address
+    * register, nor does it seem important to do so based on how many fossils
+    * it took to find a case of it being attempted during alias setup.
+    */
+   return !(src->flags & (IR3_REG_SHARED | IR3_REG_RELATIV | IR3_REG_ARRAY));
+}
+
 static bool
 can_alias_src(struct ir3_register *src)
 {
-   return is_reg_gpr(src) && !(src->flags & IR3_REG_SHARED);
+   return is_reg_gpr(src) && has_valid_alias_flags(src);
 }
 
 static bool
 can_alias_srcs_of_def(struct ir3_register *src)
 {
-   if (!can_alias_src(src)) {
+   if (!(src->flags & IR3_REG_SSA)) {
       return false;
    }
 
-   assert(src->flags & IR3_REG_SSA);
    struct ir3_instruction *def_instr = src->def->instr;
 
-   if (def_instr->opc == OPC_META_COLLECT) {
-      return true;
+   if (def_instr->opc != OPC_MOV && def_instr->opc != OPC_META_COLLECT) {
+      return false;
    }
-   if (def_instr->opc == OPC_MOV) {
-      /* We haven't seen any indication that aliasing supports the address
-       * register, nor does it seem important to do so based on how many fossils
-       * it took to find a case of it being attempted during alias setup.
-       */
-      return is_same_type_mov(def_instr) &&
-             !(def_instr->srcs[0]->flags & (IR3_REG_SHARED | IR3_REG_RELATIV));
+
+   foreach_src (def_src, def_instr) {
+      if (!has_valid_alias_flags(def_src)) {
+         return false;
+      }
    }
 
-   return false;
+   return def_instr->opc == OPC_META_COLLECT ||
+          is_same_type_mov(def_instr);
 }
 
 static bool
