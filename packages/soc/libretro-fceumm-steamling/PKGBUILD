# libretro-fceumm-steamling — the fceumm libretro core (NES, Famicom and Famicom Disk System), built from source and tuned to the SoC
# like packages/soc/mesa. Opt-in: ./build.sh --cores (STEAMLING_CORES=on) builds it, and then it
# takes over from the prebuilt copy in libretro-cores-steamling, which it replaces on update.
# Bump = move _commit, pkgver <commit date>.<short sha>.
pkgname=libretro-fceumm-steamling
pkgver=20261116.77468e5
pkgrel=1
_commit=77468e568d9fe9c48d684ca911f1a3fe7259fdf7
pkgdesc="fceumm libretro core: NES, Famicom and Famicom Disk System (built from source, SoC-tuned)"
arch=('aarch64')
url="https://github.com/libretro/libretro-fceumm"
license=('GPL-2.0-or-later')
depends=('glibc')
makedepends=('git' 'make')
provides=('steamling-libretro-fceumm')
conflicts=('steamling-libretro-fceumm')
replaces=('libretro-cores-steamling-fceumm')
source=("libretro-fceumm::git+https://github.com/libretro/libretro-fceumm.git#commit=${_commit}")
sha256sums=('SKIP')

build() {
  # Tuned to the SoC like packages/soc/mesa (sm8550 fallback for a standalone makepkg).
  local _rocknix_tune="${STEAMLING_TUNE_CFLAGS:--march=armv9-a+fp16+crypto+i8mm+bf16+memtag+sm4+sha3+nosve+nosve2 -mtune=cortex-x3 -mno-outline-atomics}"
  export CFLAGS+=" ${_rocknix_tune}" CXXFLAGS+=" ${_rocknix_tune}"
  make -C libretro-fceumm -f Makefile.libretro platform=unix
}

package() {
  install -Dm644 libretro-fceumm/fceumm_libretro.so "${pkgdir}/usr/lib/libretro/fceumm_libretro.so"
  install -Dm644 libretro-fceumm/Copying "${pkgdir}/usr/share/licenses/${pkgname}/LICENSE"
}
