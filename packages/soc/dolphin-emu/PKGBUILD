# dolphin-emu — GameCube/Wii emulator, built from source because ALARM carries no aarch64
# build and upstream's Linux binaries are x86_64-only.
pkgname=dolphin-emu
pkgver=2609a
pkgrel=1.3
pkgdesc="GameCube / Wii emulator (native aarch64 build)"
arch=('aarch64')
url="https://dolphin-emu.org"
license=('GPL-2.0-or-later')
depends=('bluez-libs' 'bzip2' 'curl' 'enet' 'ffmpeg' 'glslang' 'hidapi' 'libspng' 'libusb'
         'libx11' 'libxi' 'libxrandr' 'lz4' 'lzo' 'pugixml' 'qt6-base' 'qt6-svg' 'sdl3' 'sfml'
         'speexdsp' 'xxhash' 'xz' 'zlib-ng' 'zstd')
# dbus: Qt6's DBus component finds libdbus through pkg-config (dbus-1.pc), and the build chroot
# only has dbus-broker unless something pulls the reference dbus in.
makedepends=('alsa-lib' 'cmake' 'dbus' 'git' 'libevdev' 'libpulse' 'miniupnpc' 'ninja' 'pkgconf'
             'python' 'vulkan-headers')
options=('!lto' '!emptydirs')   # !lto per Arch upstream (miscompiles)
source=("dolphin::git+https://github.com/dolphin-emu/dolphin.git#tag=${pkgver}")
sha256sums=('SKIP')

prepare() {
  cd dolphin
  git submodule update --init --recursive
}

build() {
  # Tuned to the SoC like packages/soc/mesa (sm8550 fallback for a standalone makepkg): the
  # recompiler emits its own code at runtime, this covers everything that is not recompiled.
  local _rocknix_tune="${STEAMLING_TUNE_CFLAGS:--march=armv9-a+fp16+crypto+i8mm+bf16+memtag+sm4+sha3+nosve+nosve2 -mtune=cortex-x3 -mno-outline-atomics}"
  export CFLAGS+=" ${_rocknix_tune}" CXXFLAGS+=" ${_rocknix_tune}"
  # ENABLE_LLVM only adds a disassembler to the debugger. Left on, Dolphin links whatever LLVM
  # another package left in the build chroot without depending on it, and won't start once that
  # version is gone from the handheld.
  cmake -S dolphin -B build -G Ninja \
    -DCMAKE_BUILD_TYPE=Release \
    -DCMAKE_INSTALL_PREFIX=/usr \
    -DENABLE_ALSA=ON \
    -DENABLE_AUTOUPDATE=OFF \
    -DENABLE_TESTS=OFF \
    -DENABLE_ANALYTICS=OFF \
    -DUSE_SHARED_ENET=ON \
    -DENABLE_LLVM=OFF \
    -DDISTRIBUTOR=steamling
  ninja -C build
}

package() {
  DESTDIR="${pkgdir}" ninja -C build install
}
