# libretro-swanstation — the PlayStation core. SwanStation is the maintained GPL fork of
# DuckStation's libretro core, which upstream DuckStation dropped (the vendored
# duckstation_libretro.so it replaces was a 2018-era GCC 7 build). Vulkan and GL hardware
# renderers, the ARM64 recompiler, PGXP. Every dependency is vendored in the tree.
# Bump = move _commit, pkgver <commit date>.<short sha>.
pkgname=libretro-swanstation
pkgver=20261024.631f0fb
pkgrel=2
_commit=631f0fb31b809e0f889d7c551fe695788e39c1d3
pkgdesc="SwanStation libretro core — PlayStation, Vulkan and OpenGL (SoC-tuned)"
arch=('aarch64')
url="https://github.com/libretro/swanstation"
license=('GPL-3.0-or-later')
depends=('glibc' 'gcc-libs')
makedepends=('git' 'cmake' 'ninja')
# 0001: the shader worker warms only the texture filter in use (PATCHES.md has where it's from).
source=("swanstation::git+https://github.com/libretro/swanstation.git#commit=${_commit}"
        '0001-vulkan-warm-only-the-active-texture-filter.patch')
sha256sums=('SKIP' 'SKIP')

prepare() {
  patch -d swanstation -Np1 -i "${srcdir}/0001-vulkan-warm-only-the-active-texture-filter.patch"
}

build() {
  # Tuned to the SoC like packages/soc/mesa (sm8550 fallback for a standalone makepkg).
  local _rocknix_tune="${STEAMLING_TUNE_CFLAGS:--march=armv9-a+fp16+crypto+i8mm+bf16+memtag+sm4+sha3+nosve+nosve2 -mtune=cortex-x3 -mno-outline-atomics}"
  export CFLAGS+=" ${_rocknix_tune}" CXXFLAGS+=" ${_rocknix_tune}"
  cmake -S swanstation -B build -G Ninja -DCMAKE_BUILD_TYPE=Release
  ninja -C build
}

package() {
  install -Dm644 build/swanstation_libretro.so "${pkgdir}/usr/lib/libretro/swanstation_libretro.so"
}
