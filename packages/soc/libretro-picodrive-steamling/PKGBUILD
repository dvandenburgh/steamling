# libretro-picodrive-steamling — the picodrive libretro core (Sega 32X), built from source and
# tuned to the SoC like packages/soc/mesa. Opt-in: ./build.sh --cores (STEAMLING_CORES=on) builds
# it, and then it takes over from the prebuilt copy in libretro-cores-steamling, which it replaces
# on update.
# Pinned to the commit ROCKNIX builds for its SM8550 handhelds.
# Bump = move _commit, pkgver <commit date>.<short sha>.
pkgname=libretro-picodrive-steamling
pkgver=20261026.07abb00
pkgrel=1
_commit=07abb00550528f7bf53087d932dd3d747cf2d0df
pkgdesc="picodrive libretro core: Sega 32X (built from source, SoC-tuned)"
arch=('aarch64')
url="https://github.com/irixxxx/picodrive"
license=('LicenseRef-PicoDrive')
depends=('glibc' 'gcc-libs')
makedepends=('git' 'make')
provides=('steamling-libretro-picodrive')
conflicts=('steamling-libretro-picodrive')
replaces=('libretro-cores-steamling-picodrive')
source=("picodrive::git+https://github.com/irixxxx/picodrive.git#commit=${_commit}")
sha256sums=('SKIP')

prepare() {
  cd picodrive
  git submodule update --init --recursive
}

build() {
  # Tuned to the SoC like packages/soc/mesa (sm8550 fallback for a standalone makepkg).
  local _rocknix_tune="${STEAMLING_TUNE_CFLAGS:--march=armv9-a+fp16+crypto+i8mm+bf16+memtag+sm4+sha3+nosve+nosve2 -mtune=cortex-x3 -mno-outline-atomics}"
  export CFLAGS+=" ${_rocknix_tune}" CXXFLAGS+=" ${_rocknix_tune}"
  make -C picodrive -f Makefile.libretro platform=unix
}

package() {
  install -Dm644 picodrive/picodrive_libretro.so "${pkgdir}/usr/lib/libretro/picodrive_libretro.so"
  install -Dm644 picodrive/COPYING "${pkgdir}/usr/share/licenses/${pkgname}/LICENSE"
}
