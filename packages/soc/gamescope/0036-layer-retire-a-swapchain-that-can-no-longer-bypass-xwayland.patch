From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: Matthew Schwartz <matthew.schwartz@linux.dev>
Date: Wed, 11 Nov 2026 11:08:17 -0800
Subject: [PATCH] layer: retire a swapchain that can no longer bypass Xwayland

Losing bypass only fails presents with VK_ERROR_OUT_OF_DATE_KHR, and
acquire keeps succeeding. zink ignores that result from a present and
only recreates when acquire returns it, so it keeps flipping its frames
over a toplevel that now has other windows going through Xwayland.

Retire the swapchain so it stays out of date until recreated, as Mesa's
X11 swapchains do. The resize result stays one-shot, since drivers
report that as VK_SUBOPTIMAL_KHR.
---
 layer/VkLayer_FROG_gamescope_wsi.cpp | 4 +++-
 1 file changed, 3 insertions(+), 1 deletion(-)

diff --git a/layer/VkLayer_FROG_gamescope_wsi.cpp b/layer/VkLayer_FROG_gamescope_wsi.cpp
index 5c208b7..97ad0cd 100644
--- a/layer/VkLayer_FROG_gamescope_wsi.cpp
+++ b/layer/VkLayer_FROG_gamescope_wsi.cpp
@@ -2113,7 +2113,9 @@ namespace GamescopeWSILayer {
               if (!(gamescopeSurface->flags & GamescopeLayerClient::Flag::NoSuboptimal))
                 UpdateSwapchainResult(VK_SUBOPTIMAL_KHR);
             } else {
-              UpdateSwapchainResult(VK_ERROR_OUT_OF_DATE_KHR);  
+              // Stay out of date like a driver swapchain, zink only recreates on acquire.
+              *gamescopeSwapchain->retired = true;
+              UpdateSwapchainResult(VK_ERROR_OUT_OF_DATE_KHR);
             }
           }
 
