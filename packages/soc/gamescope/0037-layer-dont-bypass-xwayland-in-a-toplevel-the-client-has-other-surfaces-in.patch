From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: Matthew Schwartz <matthew.schwartz@linux.dev>
Date: Sun, 15 Nov 2026 18:14:54 -0800
Subject: [PATCH] layer: don't bypass Xwayland in a toplevel the client has
 other surfaces in

A bypassing surface's frames replace its whole toplevel. CEF gives each
widget its own child window there with its own surface, so on zink
Steam's full-size view flips over the toplevel and the side menus, which
go through Xwayland, flicker or never show.

Refuse to bypass while the client has a surface on any other window of
the same toplevel, mapped or not. A client is only asked about bypass
when it presents, so surfaces count from the moment they exist. CEF
creates all of its surfaces at startup, and one created after the view
has gone idle stays hidden until the view draws again, as before.
Windows without a surface don't count, which keeps bypass for a
toolkit's hidden native widgets, and HDR still bypasses as it has no
other path.

Closes: https://gitlab.freedesktop.org/mesa/mesa/-/work_items/12841
---
 layer/VkLayer_FROG_gamescope_wsi.cpp | 32 ++++++++++++++++++++++++++++
 layer/xcb_helpers.hpp                | 22 +++++++++++++++++++
 2 files changed, 54 insertions(+)

diff --git a/layer/VkLayer_FROG_gamescope_wsi.cpp b/layer/VkLayer_FROG_gamescope_wsi.cpp
index 97ad0cd..73b54c7 100644
--- a/layer/VkLayer_FROG_gamescope_wsi.cpp
+++ b/layer/VkLayer_FROG_gamescope_wsi.cpp
@@ -17,6 +17,7 @@
 #include <cstdio>
 #include <cstring>
 #include <memory>
+#include <mutex>
 #include <utility>
 #include <tuple>
 #include <vector>
@@ -566,6 +567,10 @@ namespace GamescopeWSILayer {
   };
   static vkroots::ObjectMap<VkInstance, GamescopeInstanceData> gamescopeInstances;
 
+  // One entry per X11 surface, across all instances.
+  static std::mutex gamescopeSurfaceWindowsMutex;
+  static std::vector<std::pair<xcb_connection_t*, xcb_window_t>> gamescopeSurfaceWindows;
+
   struct GamescopeSurfaceData {
     VkInstance instance;
     wl_display *display;
@@ -693,6 +698,22 @@ namespace GamescopeWSILayer {
         }
       }
 
+      // Our frames replace the whole toplevel, hiding the client's other surfaces in it.
+      std::vector<xcb_window_t> otherWindows;
+      if (!hdrColorspace) {
+        std::scoped_lock lock(gamescopeSurfaceWindowsMutex);
+        for (const auto& [otherConnection, otherWindow] : gamescopeSurfaceWindows) {
+          if (otherConnection == connection && otherWindow != window)
+            otherWindows.push_back(otherWindow);
+        }
+      }
+      if (xcb::anyWindowInToplevel(connection, std::move(otherWindows), *toplevelWindow)) {
+#if GAMESCOPE_WSI_BYPASS_DEBUG
+        fprintf(stderr, "[Gamescope WSI] Not bypassing: window 0x%x shares its toplevel with another surface.\n", window);
+#endif
+        return false;
+      }
+
       // I want to add more checks wrt. composite redirects and such here,
       // but it seems what is exposed in xcb_composite is quite limited.
       // So let's see how it goes for now. :-)
@@ -1312,6 +1333,12 @@ namespace GamescopeWSILayer {
         state.emplace(std::move(*entry));
         gamescopeSurfaces.erase(surface);
       }
+      if (state) {
+        std::scoped_lock lock(gamescopeSurfaceWindowsMutex);
+        auto entry = std::find(gamescopeSurfaceWindows.begin(), gamescopeSurfaceWindows.end(), std::pair(state->connection, state->window));
+        if (entry != gamescopeSurfaceWindows.end())
+          gamescopeSurfaceWindows.erase(entry);
+      }
       if (state)
         pDispatch.DestroySurfaceKHR(instance, state->fallbackSurface, pAllocator);
       pDispatch.DestroySurfaceKHR(instance, surface, pAllocator);
@@ -1465,6 +1492,11 @@ namespace GamescopeWSILayer {
       gamescopeSurface->waylandObjects = std::move(waylandObjects);
       *pSurface = surface;
 
+      {
+        std::scoped_lock lock(gamescopeSurfaceWindowsMutex);
+        gamescopeSurfaceWindows.emplace_back(connection, window);
+      }
+
       DumpGamescopeSurfaceState(gamescopeInstance, gamescopeSurface);
 
       return result;
diff --git a/layer/xcb_helpers.hpp b/layer/xcb_helpers.hpp
index 51e1f22..55d1777 100644
--- a/layer/xcb_helpers.hpp
+++ b/layer/xcb_helpers.hpp
@@ -2,8 +2,10 @@
 
 #include <X11/Xlib-xcb.h>
 #include <xcb/composite.h>
+#include <algorithm>
 #include <cstdio>
 #include <optional>
+#include <vector>
 
 namespace xcb {
 
@@ -131,6 +133,26 @@ namespace xcb {
     }
   }
 
+  // Whether any of these windows is the toplevel or somewhere inside it.
+  static bool anyWindowInToplevel(xcb_connection_t* connection, std::vector<xcb_window_t> windows, xcb_window_t toplevel) {
+    while (!windows.empty()) {
+      if (std::find(windows.begin(), windows.end(), toplevel) != windows.end())
+        return true;
+
+      std::vector<xcb_query_tree_cookie_t> cookies;
+      for (xcb_window_t window : windows)
+        cookies.push_back(xcb_query_tree(connection, window));
+
+      windows.clear();
+      for (xcb_query_tree_cookie_t cookie : cookies) {
+        auto reply = Reply<xcb_query_tree_reply_t>{ xcb_query_tree_reply(connection, cookie, nullptr) };
+        if (reply && reply->parent != XCB_WINDOW_NONE && reply->parent != reply->root)
+          windows.push_back(reply->parent);
+      }
+    }
+    return false;
+  }
+
   static std::optional<VkRect2D> getWindowRect(xcb_connection_t* connection, xcb_window_t window) {
     xcb_get_geometry_cookie_t cookie = xcb_get_geometry(connection, window);
     auto reply = Reply<xcb_get_geometry_reply_t>{ xcb_get_geometry_reply(connection, cookie, nullptr) };
-- 
