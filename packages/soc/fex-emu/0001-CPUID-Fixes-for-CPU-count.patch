From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: Ryan Houdek <Sonicadvance1@gmail.com>
Date: Tue, 10 Nov 2026 18:37:57 -0800
Subject: [PATCH] CPUID: Fixes for CPU count

Fixes Dragon Age: Origins - Ultimate Edition thinking we only have 1
core. Although the game does get angry when you have 32 or more cores
still.

The main change here is enabling the HTT CPUID bit. While the bit name
is called HTT it's actually been retconned over time. [1][2]

Initial SDM did infact say that the bit was used for hyperthreading, but
when the first multi-core system launched, it was also used to just
describe how many cores are in the logical processor. The real way to
determine if there is hyperthreading is to use the extended topology
information to determine how many logical processors are in each core.

Plus a minor fix for reporting CPU count to Win32 APIs.

[1] Latest SDM: `EDX bit 28, if set, indicates that bits 23:16 of CPUID.(EAX=1):EBX are valid. If this bit is not set, then the CPU package contains only 1 logical processor.`
[2] [Deep dive](https://www.os2museum.com/wp/htt-means-hyper-threading-right/)
---
 FEXCore/Source/Interface/Core/CPUID.cpp | 2 +-
 Source/Windows/Common/CPUFeatures.cpp   | 3 +++
 2 files changed, 4 insertions(+), 1 deletion(-)

diff --git a/FEXCore/Source/Interface/Core/CPUID.cpp b/FEXCore/Source/Interface/Core/CPUID.cpp
index 1f6f3f5a9..57928bb91 100644
--- a/FEXCore/Source/Interface/Core/CPUID.cpp
+++ b/FEXCore/Source/Interface/Core/CPUID.cpp
@@ -545,7 +545,7 @@ FEXCore::CPUID::FunctionResults CPUIDEmu::Function_01h(uint32_t Leaf) const {
             (1 << 25) | // SSE
             (1 << 26) | // SSE2
             (0 << 27) | // Self Snoop
-            (0 << 28) | // (HTT) Max APIC IDs reserved field is valid
+            (1 << 28) | // (HTT) Max APIC IDs reserved field is valid
             (1 << 29) | // Thermal monitor
             (0 << 30) | // Reserved
             (0 << 31);  // Pending break enable
diff --git a/Source/Windows/Common/CPUFeatures.cpp b/Source/Windows/Common/CPUFeatures.cpp
index 02ae1eeda..6b89ac10b 100644
--- a/Source/Windows/Common/CPUFeatures.cpp
+++ b/Source/Windows/Common/CPUFeatures.cpp
@@ -134,6 +134,8 @@ CPUFeatures::CPUFeatures(FEXCore::Context::Context& CTX) {
   CpuInfo.ProcessorRevision = (FamilyIdentifier & 0xf0000) >> 4;                                // Extended Model
   CpuInfo.ProcessorRevision |= (FamilyIdentifier & 0xf0) << 4;                                  // Model
   CpuInfo.ProcessorRevision |= FamilyIdentifier & 0xf;                                          // Stepping
+  // 8-bits in CPUID 01.ebx for up to 256 cores.
+  CpuInfo.MaximumProcessors = ((CPUIDResult01.ebx >> 16) & 0xFF) + 1;
 }
 
 bool CPUFeatures::IsFeaturePresent(uint32_t Feature) {
@@ -166,6 +168,7 @@ bool CPUFeatures::IsFeaturePresent(uint32_t Feature) {
 }
 
 void CPUFeatures::UpdateInformation(SYSTEM_CPU_INFORMATION* Info) {
+  Info->MaximumProcessors = CpuInfo.MaximumProcessors;
   Info->ProcessorArchitecture = CpuInfo.ProcessorArchitecture;
   Info->ProcessorLevel = CpuInfo.ProcessorLevel;
   Info->ProcessorRevision = CpuInfo.ProcessorRevision;
-- 
