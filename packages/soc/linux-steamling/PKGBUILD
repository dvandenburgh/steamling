# The selected SoC's kernel as a pacman package. Per SoC, not per device: /boot/dtbs carries every
# board under kernel/<soc>/dts and the boot menu lists what it finds. THIN by design: it compiles
# nothing; build-packages.sh stages `make kernel` output into ./staged. Packaging it at all is what
# keeps Image and modules versioned together atomically and makes a bad kernel rollback-able.
pkgname="${STEAMLING_KERNEL_PKG:?set by build-packages.sh}"
pkgver="${STEAMLING_KERNEL_VERSION:?set by build-packages.sh}"
pkgrel="${STEAMLING_KERNEL_PKGREL:?set by build-packages.sh}"
pkgdesc="${STEAMLING_SOC^^} kernel (stock ${pkgver} + ROCKNIX patch stack, SoC board dtbs) — packaged from 'make kernel' output"
arch=('aarch64')
url="https://github.com/dvandenburgh/steamling"
license=('GPL-2.0-only')   # the Linux kernel
# ALARM's generic linux-aarch64 is pre-installed in the base tarball and must go. KERNEL_LEGACY_NAMES
# (kernel.conf) lists names this SoC's kernel shipped under before, so those installs migrate.
provides=("linux=${pkgver}" ${STEAMLING_KERNEL_LEGACY_NAMES})
conflicts=('linux-aarch64' ${STEAMLING_KERNEL_LEGACY_NAMES})
replaces=('linux-aarch64' ${STEAMLING_KERNEL_LEGACY_NAMES})
# qcom-abl: python runs the shipped mkbootimg in steamling-bsp-common's on-device /flash/KERNEL
# rebuild.
case "${STEAMLING_BOOTLOADER:?set by build-packages.sh}" in qcom-abl) depends=('python') ;; esac
install=linux-steamling.install
options=('!strip')          # the kernel Image and DTBs must not be stripped

package() {
  local out="${startdir}/staged"     # = build/kernel/<soc>/out, copied in by scripts/build-packages.sh
  if [ ! -f "${out}/Image" ] || [ ! -f "${out}/kernelrelease" ]; then
    echo "${pkgname}: no staged kernel at ${out}." >&2
    echo "  Run 'make kernel DEVICE=${STEAMLING_SOC}' first (it produces build/kernel/${STEAMLING_SOC}/out), then rebuild this package." >&2
    return 1
  fi
  local kver; kver="$(cat "${out}/kernelrelease")"

  install -Dm644 "${out}/Image" "${pkgdir}/boot/Image"
  install -d "${pkgdir}/boot/dtbs"
  cp "${out}/dtbs/"*.dtb "${pkgdir}/boot/dtbs/"

  install -d "${pkgdir}/usr/lib/modules"
  cp -a "${out}/modroot/lib/modules/${kver}" "${pkgdir}/usr/lib/modules/${kver}"

  # the install scriptlet and the /flash deploy read this to find the modules dir
  install -Dm644 /dev/stdin "${pkgdir}/usr/lib/steamling/kernelrelease" <<<"${kver}"

  [ "${STEAMLING_BOOTLOADER}" = qcom-abl ] || return 0
  # On-device /flash/KERNEL rebuild path; the cmdline it reads comes from the device's BSP.
  [ -d "${out}/mkbootimg" ] || { echo "${pkgname}: ${out}/mkbootimg missing, re-run 'make kernel DEVICE=${STEAMLING_SOC}'" >&2; return 1; }
  cp -r "${out}/mkbootimg" "${pkgdir}/usr/lib/steamling/mkbootimg"
  # The build runs mkbootimg once, which leaves Python bytecode behind. Don't ship it: the
  # handheld writes its own copy the first time it runs mkbootimg, and pacman refuses to
  # upgrade over a file it didn't install.
  find "${pkgdir}/usr/lib/steamling/mkbootimg" -name __pycache__ -prune -exec rm -rf {} +
}
