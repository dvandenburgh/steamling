From: David J. Vandenburgh <david@vandenburgh.co>
Subject: [PATCH] ASoC: qdsp6: q6apm: poll for the APM state at probe

apm_probe() asks the DSP for the APM state once and waits up to 5
seconds for the answer. On a Retroid Pocket 6 the ADSP is up at 3.32 s,
its GPR devices appear at 3.35 s and the query goes out at about 3.67 s,
before the APM is listening, so it is dropped and every boot logs

  qcom-apm gprsvc:service:2:1: CMD timeout for [1001021] opcode

at 8.67 s. The next query, from q6prm's probe right after, is answered
at once. The sound card is therefore registered at 10 s instead of
about 5 s, after PipeWire has already started.

Ask in 250 ms tries, for the same 5 seconds at most, and carry on at the
first answer that says the APM is ready.

Signed-off-by: David J. Vandenburgh <david@vandenburgh.co>
---
diff --git a/sound/soc/qcom/qdsp6/q6apm.c b/sound/soc/qcom/qdsp6/q6apm.c
index 006e226..6594220 100644
--- a/sound/soc/qcom/qdsp6/q6apm.c
+++ b/sound/soc/qcom/qdsp6/q6apm.c
@@ -159,6 +159,49 @@ static int q6apm_get_apm_state(struct q6apm *apm)
 	return apm->state;
 }
 
+/*
+ * The first state query, at probe, goes out a few hundred milliseconds after
+ * the GPR device appears, and the DSP's APM is not always listening yet: it
+ * drops the query rather than answer "not ready". One 5 second wait then
+ * holds up the sound card (seen on every boot of a Retroid Pocket 6). Ask in
+ * short tries instead, for no longer in total, and stop at the first answer
+ * that says the APM is up.
+ */
+#define APM_STATE_POLL_MS	250
+#define APM_STATE_POLL_TRIES	20
+
+static void q6apm_wait_for_apm_state(struct q6apm *apm)
+{
+	struct gpr_pkt *pkt;
+	bool ready = false;
+	int i, ret;
+
+	for (i = 0; i < APM_STATE_POLL_TRIES && !ready; i++) {
+		pkt = audioreach_alloc_apm_cmd_pkt(0, APM_CMD_GET_SPF_STATE, 0);
+		if (IS_ERR(pkt))
+			return;
+
+		mutex_lock(&apm->lock);
+		apm->result.opcode = 0;
+		apm->result.status = 0;
+		ret = gpr_send_pkt(apm->gdev, pkt);
+		if (ret >= 0)
+			wait_event_timeout(apm->wait,
+					   apm->result.opcode == APM_CMD_RSP_GET_SPF_STATE,
+					   msecs_to_jiffies(APM_STATE_POLL_MS));
+		ready = apm->result.opcode == APM_CMD_RSP_GET_SPF_STATE && apm->state;
+		mutex_unlock(&apm->lock);
+		kfree(pkt);
+
+		if (ret < 0)
+			msleep(APM_STATE_POLL_MS);
+	}
+
+	if (!ready)
+		dev_warn(apm->dev, "APM did not report ready within %d ms\n",
+			 APM_STATE_POLL_MS * APM_STATE_POLL_TRIES);
+}
+
 bool q6apm_is_adsp_ready(void)
 {
 	if (g_apm)
@@ -890,7 +933,7 @@ static int apm_probe(gpr_device_t *gdev)
 
 	g_apm = apm;
 
-	q6apm_get_apm_state(apm);
+	q6apm_wait_for_apm_state(apm);
 
 	ret = snd_soc_register_component(dev, &q6apm_audio_component, NULL, 0);
 	if (ret < 0) {
