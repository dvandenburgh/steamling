# Kernel config deltas for every SoC: scripts/config arguments, applied after build-kernel.sh's
# own set and before the tree's own config-delta, then olddefconfig.

# Display blocks none of these SoCs have: they all drive DSI and DP through the DPU with the
# 7nm-family DSI PHY (its 4nm and 3nm variants live in that driver). MDP4/MDP5, HDMI and the older
# DSI PHY generations are other SoCs'.
--disable DRM_MSM_MDP4
--disable DRM_MSM_MDP5
--disable DRM_MSM_HDMI
--disable DRM_MSM_HDMI_HDCP
--disable DRM_MSM_DSI_28NM_PHY
--disable DRM_MSM_DSI_20NM_PHY
--disable DRM_MSM_DSI_28NM_8960_PHY
--disable DRM_MSM_DSI_14NM_PHY
--disable DRM_MSM_DSI_10NM_PHY

# CPU: every board has eight cores. 512 also makes arm64 select CPUMASK_OFFSTACK, which allocates
# every cpumask_var_t on the heap; at 8 they are one word on the stack.
--set-val NR_CPUS 8

# 7.3: the Qualcomm RNG moved from crypto (CRYPTO_DEV_QCOM_RNG, on before) to hw_random.
--enable HW_RANDOM_QCOM
# 7.3 also turns on, by default, clock, interconnect and pin controllers for Qualcomm SoCs no
# handheld uses (Glymur, Hawi, Maili, Nord, Shikra), built in.
--disable CLK_GLYMUR_CAMCC --disable CLK_GLYMUR_EVACC --disable CLK_GLYMUR_GCC
--disable CLK_HAWI_GCC --disable CLK_HAWI_VIDEOCC --disable CLK_MAILI_VIDEOCC
--disable CLK_NORD_DISPCC --disable CLK_NORD_GCC --disable CLK_NORD_GPUCC
--disable CLK_SHIKRA_AUDIOCORECC --disable CLK_SHIKRA_GCC
--disable INTERCONNECT_QCOM_MAILI --disable PINCTRL_MAILI

# The preemption model picked at boot instead of build time, so it can be measured without a
# rebuild: preempt=lazy (or full, voluntary, none) on the kernel command line, or at runtime
# `echo lazy > /sys/kernel/debug/sched/preempt`. Full stays the default.
--enable PREEMPT_DYNAMIC
