From: Armada <noreply@armada.local>
Subject: [PATCH] ASoC: qcom: sc8280xp: restart SoundWire streams across system suspend

With a PCM open across system suspend, the stream is re-prepared on
resume, but qcom_snd_sdw_prepare() skips a SoundWire stream that is still
marked prepared. The stream is never enabled again after the bus went
through s2idle, and headphone audio comes back thin and distorted until
every stream is closed.

Disable and deprepare the prepared SoundWire streams in suspend_post, as
hw_free does, and prepare and enable them again in resume_pre. That runs
before the BE ports are restored and DAPM powers the codec, as on a fresh
prepare. A stream that cannot be enabled yet is left to the userspace
re-prepare.

Steamling: armada-os/armada's 0085 (a2347ad) for the SM8550 tree. This
card has no suspend_post or resume_pre of its own yet (armada's sit on
top of its I2S clock release, which this tree doesn't carry), so they are
added here with only the SoundWire part. Armada tested the change with a
stream open across s2idle on an AYN Odin 2 Portal (WCD9385), one of this
tree's boards.
---
 sound/soc/qcom/sc8280xp.c | 63 ++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++
 1 file changed, 63 insertions(+)

--- a/sound/soc/qcom/sc8280xp.c
+++ b/sound/soc/qcom/sc8280xp.c
@@ -76,6 +76,7 @@
 
 struct sc8280xp_snd_data {
 	bool stream_prepared[AFE_PORT_MAX];
+	bool sdw_suspended[AFE_PORT_MAX];
 	struct snd_soc_card *card;
 	struct snd_soc_jack jack;
 	struct snd_soc_jack dp_jack[8];
@@ -393,6 +394,65 @@
 	}
 }
 
+/*
+ * qcom_snd_sdw_prepare() skips a SoundWire stream still marked prepared, so a
+ * stream open across system suspend would never be enabled again once the bus
+ * went through s2idle. Tear the prepared streams down as hw_free does, and
+ * bring them back before the ports are restored and DAPM powers the codec, as
+ * a fresh prepare would. A stream that cannot be enabled yet is left to the
+ * re-prepare from userspace.
+ */
+static int sc8280xp_snd_suspend_post(struct snd_soc_card *card)
+{
+	struct sc8280xp_snd_data *pdata = snd_soc_card_get_drvdata(card);
+	struct snd_soc_pcm_runtime *rtd;
+	int dir;
+
+	for_each_card_rtds(card, rtd) {
+		struct snd_soc_dai *cpu_dai = snd_soc_rtd_to_cpu(rtd, 0);
+
+		if (!cpu_dai || cpu_dai->id >= AFE_PORT_MAX ||
+		    !pdata->stream_prepared[cpu_dai->id])
+			continue;
+		for_each_pcm_streams(dir) {
+			struct snd_pcm_substream *ss = snd_soc_dpcm_get_substream(rtd, dir);
+
+			if (ss && pdata->stream_prepared[cpu_dai->id]) {
+				qcom_snd_sdw_hw_free(ss, &pdata->stream_prepared[cpu_dai->id]);
+				pdata->sdw_suspended[cpu_dai->id] = !pdata->stream_prepared[cpu_dai->id];
+			}
+		}
+	}
+
+	return 0;
+}
+
+static int sc8280xp_snd_resume_pre(struct snd_soc_card *card)
+{
+	struct sc8280xp_snd_data *pdata = snd_soc_card_get_drvdata(card);
+	struct snd_soc_pcm_runtime *rtd;
+	int dir;
+
+	for_each_card_rtds(card, rtd) {
+		struct snd_soc_dai *cpu_dai = snd_soc_rtd_to_cpu(rtd, 0);
+
+		if (!cpu_dai || cpu_dai->id >= AFE_PORT_MAX ||
+		    !pdata->sdw_suspended[cpu_dai->id])
+			continue;
+		pdata->sdw_suspended[cpu_dai->id] = false;
+		for_each_pcm_streams(dir) {
+			struct snd_pcm_substream *ss = snd_soc_dpcm_get_substream(rtd, dir);
+
+			if (ss && !pdata->stream_prepared[cpu_dai->id] &&
+			    qcom_snd_sdw_prepare(ss, &pdata->stream_prepared[cpu_dai->id]))
+				dev_warn(card->dev, "%s: SoundWire re-enable deferred to prepare\n",
+					 cpu_dai->name);
+		}
+	}
+
+	return 0;
+}
+
 static int sc8280xp_platform_probe(struct platform_device *pdev)
 {
 	struct snd_soc_card *card;
@@ -428,6 +488,9 @@
 	if (ret)
 		return ret;
 
+	card->suspend_post = sc8280xp_snd_suspend_post;
+	card->resume_pre = sc8280xp_snd_resume_pre;
+
 	card->driver_name = data->priv->driver_name;
 	sc8280xp_add_be_ops(card);
 	return devm_snd_soc_register_card(dev, card);
